rules_version = '2';

// Security for all persistent data. The client is never trusted (CLAUDE.md).
// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function workspace(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    // State after the current batch; used when a workspace and its code are created together.
    function workspaceAfter(wid) {
      return getAfter(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    function isMember(wid) {
      return signedIn() && request.auth.uid in workspace(wid).memberIds;
    }

    // Roles (D-098): owners (any number, never none), editors, viewers. Viewers read and keep their own reports only.
    function roleIn(data) {
      return signedIn() && request.auth.uid in data.memberIds && request.auth.uid in data.roles
        ? data.roles[request.auth.uid] : null;
    }

    function isOwner(wid) {
      return roleIn(workspace(wid)) == 'owner';
    }

    function canEdit(wid) {
      return roleIn(workspace(wid)) in ['owner', 'editor'];
    }

    // Every member has one known role, and at least one of them owns it.
    function validRoles(d) {
      return d.roles.keys().hasOnly(d.memberIds)
        && d.memberIds.toSet().hasOnly(d.roles.keys().toSet())
        && d.roles.values().hasOnly(['owner', 'editor', 'viewer'])
        && d.roles.values().hasAny(['owner']);
    }

    // Your verified Google address, lowercased like the invite list (D-062).
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function invited(data) {
      return signedIn()
        && request.auth.token.email_verified == true
        && 'invitedEmails' in data
        && myEmail() in data.invitedEmails;
    }

    // ---- Workspace content shapes ----

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function optText(d, key, max) {
      return !(key in d) || isText(d[key], max);
    }

    function optIn(d, key, values) {
      return !(key in d) || d[key] in values;
    }

    // Customers, problems, ideas, features and packages: cards on a plane (D-187), `pieceId` the plane.
    function validCard(d) {
      return isText(d.title, 200)
        && optText(d, 'body', 20000)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && d.x is number && d.y is number
        && optIn(d, 'validation', ['hypothesis', 'testing', 'validated', 'invalidated'])
        && isText(d.pieceId, 128)
        // Its parts folded into it (D-164, D-226), a package's members (D-239).
        && optBool(d, 'folded');
    }

    // What was learned, on a customer, problem or idea (D-137).
    function validEvidence(d) {
      return isText(d.nodeId, 128)
        && d.nodeType in ['customer', 'problem', 'idea']
        && d.kind in ['interview', 'quote', 'data', 'observation', 'link']
        && isText(d.text, 2000) && d.text.size() > 0
        && d.stance in ['supports', 'contradicts']
        && optText(d, 'source', 200)
        && optText(d, 'url', 2000)
        && (!('date' in d) || (d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && d.createdAt is number;
    }

    function validFeature(d) {
      return validCard(d)
        && optIn(d, 'priority', ['P1', 'P2', 'P3'])
        && optIn(d, 'status', ['idea', 'planned', 'building', 'shipped'])
        && optIn(d, 'effort', ['S', 'M', 'L'])
        && optIn(d, 'impact', ['low', 'medium', 'high'])
        // What it must do (D-133): a short list; the cells score against it.
        && (!('criteria' in d) || (d.criteria is list && d.criteria.size() <= 8));
    }

    function validCompetitor(d) {
      return isText(d.name, 200)
        && optText(d, 'url', 2000)
        && optText(d, 'description', 20000)
        && optText(d, 'pricing', 2000)
        && optText(d, 'audience', 2000)
        && optText(d, 'notes', 20000)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        // Where it operates (D-145).
        && (!('regions' in d) || (d.regions is list && d.regions.size() <= 20))
        && d.x is number && d.y is number
        && isText(d.pieceId, 128)
        && optBool(d, 'folded');
    }

    // Text anywhere (D-188): headings, paragraphs, sticky notes, sections (a frame with a name, w/h its size) and the
    // project title, in a space (`canvas` or a plane's id), x/y its top-left corner in that space's px.
    function optSize(d, key) {
      return !(key in d) || (d[key] is number && d[key] > 0 && d[key] <= 100000);
    }

    function optBool(d, key) {
      return !(key in d) || d[key] is bool;
    }

    // A paragraph (size note) and a sticky note run longer than a heading (D-156, D-158).
    function longText(d) {
      return ('size' in d && d.size == 'note') || ('kind' in d && d.kind == 'sticky');
    }

    function validLabel(d) {
      return isText(d.text, longText(d) ? 4000 : 200)
        && optText(d, 'color', 20)
        && optIn(d, 'size', ['heading', 'subheading', 'minor', 'note'])
        && optBool(d, 'bold') && optBool(d, 'italic') && optBool(d, 'caps')
        && optIn(d, 'kind', ['title', 'section', 'sticky'])
        && optIn(d, 'rotate', [90, -90])
        && optText(d, 'kicker', 60)
        && optIn(d, 'side', ['left'])
        && optIn(d, 'scale', ['small', 'medium', 'large'])
        && optBool(d, 'folded')
        && optText(d, 'uid', 128) && optText(d, 'author', 200)
        && optSize(d, 'w') && optSize(d, 'h')
        && (!('kind' in d) || d.kind != 'section' || ('w' in d && 'h' in d))
        && isText(d.pieceId, 128)
        && d.x is number && d.y is number;
    }

    // A package (D-239): a card holding a piece of the chain by id, on its plane.
    function validPackage(d) {
      return validCard(d)
        && d.memberIds is list && d.memberIds.size() <= 60
        && optIn(d, 'impact', ['low', 'medium', 'high'])
        && optIn(d, 'effort', ['S', 'M', 'L']);
    }

    // Something on the workspace's canvas (D-176): a plane (D-180), a matrix, a table, documents; a box in canvas pixels.
    function validPiece(d) {
      return d.kind in ['plane', 'matrix', 'table', 'documents', 'document', 'kanban']
        && d.x is number && d.y is number
        && d.w is number && d.w > 0 && d.w <= 100000
        && d.h is number && d.h > 0 && d.h <= 100000
        && optText(d, 'name', 80)
        // A matrix's setup (D-204), on matrices only.
        && (!('matrix' in d) || (d.kind == 'matrix' && validMatrix(d.matrix)))
        // A table's setup (D-209), on tables only.
        && (!('table' in d) || (d.kind == 'table' && validTable(d.table)))
        // The documents list's setup (D-232), on documents lists only; the document a document piece shows.
        && (!('documents' in d) || (d.kind == 'documents' && validDocuments(d.documents)))
        && (d.kind != 'document' || isText(d.docId, 128))
        && (!('docId' in d) || d.kind == 'document')
        // A kanban's columns (D-251), on kanbans only.
        && (!('kanban' in d) || (d.kind == 'kanban' && validKanban(d.kanban)))
        // Stuck to a plane's edge (D-210): a matrix or a table.
        && (!('stuckTo' in d) || (d.kind in ['matrix', 'table', 'kanban'] && isText(d.stuckTo, 128)))
        // Opened onto the canvas (D-228): a matrix or a table; a documents list or a document (D-234).
        && (!('open' in d) || (d.kind in ['matrix', 'table', 'documents', 'document', 'kanban'] && d.open is bool))
        && d.createdAt is number
        && d.updatedAt is number;
    }

    // Two lists crossed (D-204): each axis a card type's cards and entries added by hand (src/data/matrix.ts).
    function validAxis(a) {
      return a is map
        && a.items is list && a.items.size() <= 200
        && optIn(a, 'type', ['customer', 'problem', 'competitor', 'idea', 'feature'])
        && optText(a, 'plane', 128)
        && optText(a, 'noun', 40)
        && (!('hide' in a) || (a.hide is list && a.hide.size() <= 200))
        // Its features unfolded into what they're judged on, and the ones shown open (D-249).
        && optIn(a, 'unfold', ['criteria'])
        && (!('open' in a) || (a.open is list && a.open.size() <= 200));
    }

    function validMatrix(m) {
      return m is map
        && validAxis(m.rows) && validAxis(m.cols)
        && m.cell in ['scale', 'number', 'text']
        && m.steps is list && m.steps.size() <= 9
        && optText(m, 'unit', 20)
        && optBool(m, 'notRelevant') && optBool(m, 'confidence') && optBool(m, 'reading')
        // The totals' place and look, a scale's cells as marks (D-212).
        && optIn(m, 'totalsAt', ['head', 'end', 'both']) && optIn(m, 'totalsAs', ['squares', 'number', 'bar'])
        && optBool(m, 'marks');
    }

    // How a documents piece lists them (D-232, src/data/documents.ts): a table or a shelf, which kinds, sorted, paged.
    function validDocuments(t) {
      return t is map
        && t.keys().hasOnly(['view', 'kinds', 'sort', 'pageSize'])
        && t.view in ['table', 'shelf']
        && (!('kinds' in t) || (t.kinds is list && t.kinds.size() <= 4 && t.kinds.toSet().hasOnly(['markdown', 'image', 'pdf', 'report'].toSet())))
        && (!('sort' in t) || (t.sort is map && t.sort.col in ['kind', 'title', 'by', 'size', 'added'] && optBool(t.sort, 'desc')))
        && (!('pageSize' in t) || (t.pageSize is int && t.pageSize > 0 && t.pageSize <= 100));
    }

    // A kanban's columns (D-251, src/data/tasks.ts): one to twelve, each an id, a name and whether it's the finished one.
    function validKanban(k) {
      return k is map
        && k.keys().hasOnly(['cols', 'everyPlane', 'rows'])
        && k.cols is list && k.cols.size() >= 1 && k.cols.size() <= 12
        // Stuck to a plane, every task shown, not only that plane's (D-255).
        && optBool(k, 'everyPlane')
        // Its lanes (D-258).
        && optIn(k, 'rows', ['assignee', 'card']);
    }

    // One of a kanban's tasks (D-251, src/data/tasks.ts): in a column of a kanban, in order; given to a member, due on a
    // day, pointing at a card, with a checklist.
    function validTask(d) {
      return d.keys().hasOnly(['pieceId', 'col', 'order', 'title', 'notes', 'assignee', 'assigneeName', 'due', 'cardId', 'cardType', 'checks', 'learned', 'labels', 'priority', 'uid', 'createdAt', 'updatedAt'])
        && isText(d.pieceId, 128) && isText(d.col, 40)
        && d.order is number
        && isText(d.title, 200)
        && optText(d, 'notes', 20000)
        && optText(d, 'assignee', 128) && optText(d, 'assigneeName', 200)
        && (!('due' in d) || (d.due is string && d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && optText(d, 'cardId', 128)
        && optIn(d, 'cardType', ['customer', 'problem', 'competitor', 'idea', 'feature', 'package'])
        && (!('checks' in d) || (d.checks is list && d.checks.size() <= 50))
        // The evidence it logged on its card, or 'skip' (D-254).
        && optText(d, 'learned', 128)
        // Its #labels and priority (D-256).
        && (!('labels' in d) || (d.labels is list && d.labels.size() <= 20))
        && optIn(d, 'priority', ['P1', 'P2', 'P3'])
        && isText(d.uid, 128)
        && d.createdAt is number
        && d.updatedAt is number;
    }

    // Where a lens's rows come from (D-209, src/data/source.ts): rules, cards taken out, entries added by hand.
    function validSource(s) {
      return s is map
        && s.rules is list && s.rules.size() <= 12
        && s.items is list && s.items.size() <= 200
        && (!('hide' in s) || (s.hide is list && s.hide.size() <= 200));
    }

    // A table (D-209, src/data/table.ts): its rows' source, its columns, how it's sorted.
    function validTable(t) {
      return t is map
        && validSource(t.rows)
        && t.cols is list && t.cols.size() <= 30
        && optBool(t, 'manual')
        && (!('sort' in t) || (t.sort is map && isText(t.sort.col, 128)));
    }

    // One of a matrix's (D-204) or a table's (D-209) cells: the id is fixed by the matrix, its row and its column.
    function validCell(id, d) {
      return isText(d.matrixId, 128) && isText(d.row, 128) && isText(d.col, 128)
        && id == d.matrixId + '_' + d.row + '_' + d.col
        && (!('value' in d) || d.value is number || isText(d.value, 200))
        && optText(d, 'notes', 20000)
        && optBool(d, 'notRelevant')
        && optIn(d, 'confidence', ['documented', 'inferred', 'guess'])
        && d.updatedAt is number;
    }

    function validCompetitorFeature(d) {
      return isText(d.competitorId, 128)
        && isText(d.name, 200)
        && optText(d, 'description', 20000)
        && optText(d, 'category', 100)
        // How it's offered, and where it was seen (D-164).
        && optIn(d, 'availability', ['free', 'paid', 'enterprise', 'beta'])
        && optText(d, 'url', 2000);
    }

    // One of ours against one competitor (D-221): which of theirs matches it, and its must-haves' scores (D-133). The id is
    // fixed by its two ends.
    function validComparison(id, d) {
      return isText(d.featureId, 128)
        && isText(d.competitorId, 128)
        && id == d.featureId + '_' + d.competitorId
        && optText(d, 'competitorFeatureId', 128)
        // Criterion id → score.
        && (!('criteria' in d) || (d.criteria is map && d.criteria.size() <= 8
          && d.criteria.values().hasOnly(['met', 'part', 'no'])));
    }

    function validEdge(d) {
      let types = ['customer', 'problem', 'idea', 'feature', 'competitor', 'competitorFeature', 'package'];
      return isText(d.fromId, 128) && isText(d.toId, 128) && d.fromId != d.toId
        && d.fromType in types && d.toType in types
        && isText(d.kind, 40)
        && optText(d, 'label', 200)
        && (!('bends' in d) || (d.bends is list && d.bends.size() <= 8));
    }

    function valid(wid, collection, id, d) {
      return (collection == 'labels' && validLabel(d))
        || (collection == 'customers' && validCard(d))
        || (collection == 'problems' && validCard(d))
        || (collection == 'ideas' && validCard(d))
        || (collection == 'features' && validFeature(d))
        || (collection == 'competitors' && validCompetitor(d))
        || (collection == 'competitorFeatures' && validCompetitorFeature(d))
        || (collection == 'comparisons' && validComparison(id, d))
        || (collection == 'edges' && validEdge(d))
        || (collection == 'evidence' && validEvidence(d))
        || (collection == 'packages' && validPackage(d))
        || (collection == 'pieces' && validPiece(d))
        || (collection == 'cells' && validCell(id, d))
        || (collection == 'tasks' && validTask(d));
    }

    match /workspaces/{wid} {
      // Invited people see the workspace doc (name, member count) to accept or decline, not its content.
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds || invited(resource.data));

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.inviteCode is string
        && optText(request.resource.data, 'description', 1000);

      allow update: if editing() || joiningByInvite() || decliningInvite() || leaving() || ownerManaging();

      allow delete: if roleIn(resource.data) == 'owner';

      // Owners and editors rename it and say what it's building.
      function editing() {
        return roleIn(resource.data) in ['owner', 'editor']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
          && optText(request.resource.data, 'description', 1000);
      }

      // Owners manage members, roles and the invite code (D-098): any role for anyone, themselves included, as long as
      // someone still owns it. The creator (`ownerId`) never changes.
      function ownerManaging() {
        return roleIn(resource.data) == 'owner'
          && request.resource.data.ownerId == resource.data.ownerId
          && validRoles(request.resource.data)
          && optText(request.resource.data, 'description', 1000)
          && (!('invitedEmails' in request.resource.data)
            || (request.resource.data.invitedEmails is list && request.resource.data.invitedEmails.size() <= 100));
      }

      // Accept an email invite (D-062): add only yourself, as editor, and use up your invite.
      // A code alone no longer joins anyone; it only sends a request the owner approves (joinRequests below).
      function joiningByInvite() {
        return invited(resource.data)
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'invitedEmails'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == 'editor'
          && request.resource.data.invitedEmails == resource.data.invitedEmails.removeAll([myEmail()]);
      }

      // Turn an invite down: remove only your own address.
      function decliningInvite() {
        return invited(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedEmails'])
          && request.resource.data.invitedEmails == resource.data.invitedEmails.removeAll([myEmail()]);
      }

      // Anyone removes only themselves, as long as someone still owns it (the last owner deletes it instead).
      function leaving() {
        return signedIn()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.roles.values().hasAny(['owner'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.roles);
      }

      // The assistant's workspace key settings (D-079). Members read them (is there a key, may I use it); the owner picks
      // who may use it. hasKey / keyHint are written only by the setWorkspaceKey function, never by a client.
      match /ai/{docId} {
        function validAccess(d) {
          return (!('access' in d) || d.access in ['everyone', 'chosen'])
            && (!('allowed' in d) || (d.allowed is list && d.allowed.size() <= 100));
        }
        // The owners' model per task on the workspace key, and the others members may pick (D-104).
        function validModels(d) {
          return (!('models' in d) || (d.models is map
              && d.models.keys().hasOnly(['chat', 'research', 'deep'])
              && (!('chat' in d.models) || isText(d.models.chat, 100))
              && (!('research' in d.models) || isText(d.models.research, 100))
              && (!('deep' in d.models) || isText(d.models.deep, 100))))
            && (!('allowedModels' in d) || (d.allowedModels is list && d.allowedModels.size() <= 20));
        }
        allow read: if isMember(wid);
        allow create: if docId == 'config' && isOwner(wid)
          && request.resource.data.keys().hasOnly(['access', 'allowed', 'models', 'allowedModels'])
          && validAccess(request.resource.data) && validModels(request.resource.data);
        allow update: if docId == 'config' && isOwner(wid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access', 'allowed', 'models', 'allowedModels'])
          && validAccess(request.resource.data) && validModels(request.resource.data);
      }

      // What each assistant call used (D-079): time, task, model, tokens, searches; never the messages.
      // Append-only. You log your own-key calls; workspace-key calls are logged by the server.
      // You see your own entries; the owner also sees everyone's workspace-key entries, never someone's own-key ones.
      match /aiUsage/{id} {
        function count(v) {
          return v is int && v >= 0;
        }
        allow create: if isMember(wid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'keySource', 'task', 'model', 'inputTokens', 'cachedTokens', 'outputTokens', 'reasoningTokens', 'webSearches', 'tools', 'status', 'ms', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keySource == 'own'
          && isText(request.resource.data.name, 200)
          && request.resource.data.task in ['chat', 'research']
          && isText(request.resource.data.model, 100)
          && count(request.resource.data.inputTokens) && count(request.resource.data.cachedTokens)
          && count(request.resource.data.outputTokens) && count(request.resource.data.reasoningTokens)
          && count(request.resource.data.webSearches) && count(request.resource.data.ms)
          && request.resource.data.tools is list && request.resource.data.tools.size() <= 10
          && request.resource.data.status in ['done', 'stopped', 'failed']
          && request.resource.data.at is int && request.resource.data.at <= request.time.toMillis() + 60000;
        allow read: if signedIn()
          && (resource.data.uid == request.auth.uid
            || (resource.data.keySource == 'workspace' && isOwner(wid)));
      }

      // Research reports (D-090) from before documents (D-232): each is moved to `documents` once, by its author's browser
      // or an owner's (documents.ts' moveReports), then deleted here. Nothing writes new ones. Read by whoever may see it
      // (its author, or everyone once shared); deleted by its author, an owner a shared one. A report's content is in
      // content/body, or, saved before D-098, inline.
      match /reports/{id} {
        function mayRead(d) {
          return isMember(wid) && (d.shared == true || d.uid == request.auth.uid);
        }
        function mayDelete(d) {
          return isMember(wid) && (d.uid == request.auth.uid || (d.shared == true && isOwner(wid)));
        }
        allow read: if resource == null ? isMember(wid) : mayRead(resource.data);
        allow delete: if mayDelete(resource.data);

        function summary() {
          return get(/databases/$(database)/documents/workspaces/$(wid)/reports/$(id)).data;
        }
        match /content/{part} {
          allow read: if part == 'body' && mayRead(summary());
          allow delete: if part == 'body' && isMember(wid)
            && (!exists(/databases/$(database)/documents/workspaces/$(wid)/reports/$(id)) || mayDelete(summary()));
        }
      }

      // Documents (D-232): every file the workspace keeps (.md, images, PDFs, the old reports moved over). Seen only by
      // whoever added it until they share it; then by every member. Any member adds their own (viewers too, as they kept
      // reports, D-098); only its author shares, unshares or renames it, and nothing else in it changes. The author
      // deletes it, an owner a shared one. Undoing an owner's delete restores someone else's shared document, and moving
      // old reports writes them as their author's, so an owner may create a shared one for anyone.
      // The content is in content/body, read by whoever reads the summary. Shapes mirror src/data/documents.ts.
      match /documents/{id} {
        function validDoc(d) {
          return d.keys().hasOnly(['kind', 'title', 'excerpt', 'origin', 'uid', 'name', 'shared', 'contentType', 'size',
              'words', 'pages', 'sections', 'sources', 'width', 'height', 'path', 'thumbPath', 'topic', 'model', 'reportKind',
              'createdAt', 'updatedAt'])
            && d.kind in ['markdown', 'image', 'pdf', 'report']
            && isText(d.title, 300) && d.title.size() > 0
            && optText(d, 'excerpt', 400)
            && d.origin in ['upload', 'assistant', 'moved']
            && isText(d.uid, 128) && isText(d.name, 200)
            && d.shared is bool
            && optIn(d, 'contentType', ['text/markdown', 'image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/svg+xml', 'application/pdf'])
            && d.size is int && d.size >= 0 && d.size <= 10485760
            && optCount(d, 'words') && optCount(d, 'pages') && optCount(d, 'sections') && optCount(d, 'sources')
            && optCount(d, 'width') && optCount(d, 'height')
            // A file sits under its own id (D-083's layout).
            && (!('path' in d) || (isText(d.path, 400) && d.path.matches('workspaces/' + wid + '/documents/' + id + '/.+')))
            && (!('thumbPath' in d) || (isText(d.thumbPath, 400) && d.thumbPath.matches('workspaces/' + wid + '/documents/' + id + '/.+')))
            && optText(d, 'topic', 500) && optText(d, 'model', 100)
            && optIn(d, 'reportKind', ['research', 'chat', 'upload'])
            && d.createdAt is number && d.updatedAt is number;
        }
        function optCount(d, key) {
          return !(key in d) || (d[key] is int && d[key] >= 0);
        }
        function mayRead(d) {
          return isMember(wid) && (d.shared == true || d.uid == request.auth.uid);
        }
        function mayCreate(d) {
          return isMember(wid) && validDoc(d) && (d.uid == request.auth.uid || (d.shared == true && isOwner(wid)));
        }
        function mayDelete(d) {
          return isMember(wid) && (d.uid == request.auth.uid || (d.shared == true && isOwner(wid)));
        }
        // Not there yet reads as missing to any member, as reports do (a listener refused once never comes back).
        allow read: if resource == null ? isMember(wid) : mayRead(resource.data);
        allow create: if mayCreate(request.resource.data);
        allow update: if isMember(wid) && resource.data.uid == request.auth.uid && validDoc(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared', 'title', 'updatedAt']);
        allow delete: if mayDelete(resource.data);

        function summary() {
          return get(/databases/$(database)/documents/workspaces/$(wid)/documents/$(id)).data;
        }
        function summaryAfter() {
          return getAfter(/databases/$(database)/documents/workspaces/$(wid)/documents/$(id)).data;
        }
        // A .md's text, or a report's answer and sections; written with its summary (the same batch, hence getAfter).
        match /content/{part} {
          function validBody(b) {
            return b.keys().hasOnly(['text', 'answer', 'sections', 'implications', 'openQuestions', 'sources'])
              && (!('text' in b) || (b.text is string && b.text.size() <= 900000))
              && optText(b, 'answer', 4000)
              && (!('sections' in b) || (b.sections is list && b.sections.size() <= 30))
              && (!('implications' in b) || (b.implications is list && b.implications.size() <= 20))
              && (!('openQuestions' in b) || (b.openQuestions is list && b.openQuestions.size() <= 30))
              && (!('sources' in b) || (b.sources is list && b.sources.size() <= 200));
          }
          allow read: if part == 'body' && mayRead(summary());
          allow create: if part == 'body' && validBody(request.resource.data)
            && isMember(wid) && (summaryAfter().uid == request.auth.uid || (summaryAfter().shared == true && isOwner(wid)));
          allow delete: if part == 'body'
            && (!exists(/databases/$(database)/documents/workspaces/$(wid)/documents/$(id)) ? isMember(wid) : mayDelete(summary()));
        }
      }

      // Who is in the workspace, by name (D-098). Each member writes their own entry; owners write one when they let
      // someone in, and remove it with them. Their role lives on the workspace doc.
      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['name', 'email', 'photo', 'joinedAt'])
            && isText(d.name, 200)
            && optText(d, 'email', 320)
            && optText(d, 'photo', 2000)
            && d.joinedAt is number;
        }
        allow read: if isMember(wid);
        allow create, update: if validMember(request.resource.data)
          && ((request.auth.uid == uid && isMember(wid)) || isOwner(wid));
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(wid));
      }

      // Comment threads (D-159): any member starts one or answers, viewers too, always as themselves. Not content: no
      // undo, so the shapes are checked here and the writer is tied to the message. A thread changes only by answers
      // (count, time) and being resolved or reopened; owners and editors delete any, a starter one nobody answered.
      match /threads/{tid} {
        function validThread(d) {
          return d.keys().hasOnly(['on', 'targetId', 'planeId', 'x', 'y', 'uid', 'name', 'count', 'lastAt', 'lastUid', 'lastName', 'lastText', 'mentions', 'resolved', 'resolvedBy', 'createdAt', 'updatedAt'])
            // 'plane' (D-193): a comment on a plane on the canvas.
            && d.on in ['card', 'label', 'link', 'plane']
            && isText(d.targetId, 128)
            && isText(d.planeId, 128)
            && d.x is number && d.y is number
            && isText(d.uid, 128) && isText(d.name, 200)
            && d.count is int && d.count >= 0 && d.count <= 100000
            && d.lastAt is number
            && optText(d, 'lastUid', 128) && optText(d, 'lastName', 200) && optText(d, 'lastText', 160)
            && (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 50))
            && optBool(d, 'resolved') && optText(d, 'resolvedBy', 128)
            && d.createdAt is number && d.updatedAt is number;
        }
        allow read: if isMember(wid);
        allow create: if isMember(wid) && validThread(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.count == 1
          && (!('lastUid' in request.resource.data) || request.resource.data.lastUid == request.auth.uid);
        allow update: if isMember(wid) && validThread(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt', 'lastUid', 'lastName', 'lastText', 'mentions', 'resolved', 'resolvedBy', 'updatedAt'])
          && (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == request.auth.uid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolvedBy']))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastUid']) || request.resource.data.lastUid == request.auth.uid);
        // Owners, or whoever started it while nobody has answered (D-166: editors no longer delete others' words).
        allow delete: if isOwner(wid) || (isMember(wid) && resource.data.uid == request.auth.uid && resource.data.count <= 1);

        match /messages/{mid} {
          function validMessage(d) {
            return d.keys().hasOnly(['uid', 'name', 'text', 'mentions', 'createdAt', 'editedAt'])
              && (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 20))
              && isText(d.uid, 128) && isText(d.name, 200)
              && isText(d.text, 2000) && d.text.size() > 0
              && d.createdAt is number
              && (!('editedAt' in d) || d.editedAt is number);
          }
          allow read: if isMember(wid);
          allow create: if isMember(wid) && validMessage(request.resource.data)
            && request.resource.data.uid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/workspaces/$(wid)/threads/$(tid));
          allow update: if isMember(wid) && resource.data.uid == request.auth.uid
            && validMessage(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt']);
          // Only its writer takes a message back (D-166); an owner's goes only with its whole thread, in the same batch.
          allow delete: if isMember(wid) && (resource.data.uid == request.auth.uid
            || (isOwner(wid) && !existsAfter(/databases/$(database)/documents/workspaces/$(wid)/threads/$(tid))));
        }
      }

      // What each member has read of the threads (D-166): theirs alone to read and write; owners clear them with the
      // workspace.
      match /threadReads/{uid} {
        allow read: if isMember(wid) && request.auth.uid == uid;
        allow create, update: if isMember(wid) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['seen', 'updatedAt'])
          && request.resource.data.seen is map
          && request.resource.data.updatedAt is number;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(wid));
      }

      // Workspace content: members read it, owners and editors change it (D-098); known collections only, with a sane shape.
      // Shapes mirror src/data/model.ts; change both together.
      match /{collection}/{docId} {
        function known() {
          return collection in ['labels', 'customers', 'problems', 'ideas', 'features', 'competitors', 'competitorFeatures', 'comparisons', 'edges', 'evidence', 'packages', 'pieces', 'cells', 'tasks'];
        }
        allow read: if isMember(wid) && known();
        allow delete: if canEdit(wid) && known();
        allow create, update: if canEdit(wid) && valid(wid, collection, docId, request.resource.data);
      }
    }

    // A workspace's OpenAI key, encrypted (D-079). Only the Cloud Functions (admin) read or write it; no client ever can.
    match /aiSecrets/{wid} {
      allow read, write: if false;
    }

    // Lookup by exact code only; codes can't be listed or enumerated.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if roleIn(workspaceAfter(request.resource.data.workspaceId)) == 'owner'
        && workspaceAfter(request.resource.data.workspaceId).inviteCode == code
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOwner(resource.data.workspaceId);
    }

    // Asking to join with a code (D-062). The id is `<workspaceId>_<uid>`: one request per person per workspace.
    // An owner approves (adds the member and deletes the request in one batch) or denies (deletes it); any owner settles
    // them, querying by workspace (D-098).
    match /joinRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['workspaceId', 'uid', 'name', 'email', 'code', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.workspaceId + '_' + request.auth.uid
        && request.resource.data.code == workspace(request.resource.data.workspaceId).inviteCode
        && !(request.auth.uid in workspace(request.resource.data.workspaceId).memberIds)
        && request.resource.data.email == request.auth.token.email
        && isText(request.resource.data.name, 200)
        && request.resource.data.createdAt is number;
      // The requester sees and withdraws their own; the workspace's owners see and settle them.
      allow read, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner(resource.data.workspaceId));
    }
  }
}
