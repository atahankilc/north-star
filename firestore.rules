rules_version = '2';

// Security for all persistent data. The client is never trusted (CLAUDE.md).
// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function workspace(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    // State after the current batch; used when a workspace and its code are created together.
    function workspaceAfter(wid) {
      return getAfter(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    function isMember(wid) {
      return signedIn() && request.auth.uid in workspace(wid).memberIds;
    }

    // Roles (D-098): owners (any number, never none), editors, viewers. Viewers read and keep their own reports only.
    function roleIn(data) {
      return signedIn() && request.auth.uid in data.memberIds && request.auth.uid in data.roles
        ? data.roles[request.auth.uid] : null;
    }

    function isOwner(wid) {
      return roleIn(workspace(wid)) == 'owner';
    }

    function canEdit(wid) {
      return roleIn(workspace(wid)) in ['owner', 'editor'];
    }

    // Every member has one known role, and at least one of them owns it.
    function validRoles(d) {
      return d.roles.keys().hasOnly(d.memberIds)
        && d.memberIds.toSet().hasOnly(d.roles.keys().toSet())
        && d.roles.values().hasOnly(['owner', 'editor', 'viewer'])
        && d.roles.values().hasAny(['owner']);
    }

    // Your verified Google address, lowercased like the invite list (D-062).
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function invited(data) {
      return signedIn()
        && request.auth.token.email_verified == true
        && 'invitedEmails' in data
        && myEmail() in data.invitedEmails;
    }

    // ---- Workspace content shapes ----

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function optText(d, key, max) {
      return !(key in d) || isText(d[key], max);
    }

    function optIn(d, key, values) {
      return !(key in d) || d[key] in values;
    }

    // Domains are retired (D-048); older items may still carry these fields, so they're tolerated, not required.
    function validDomainRefs(d) {
      return optText(d, 'domainId', 128)
        && (!('domainIds' in d) || (d.domainIds is list && d.domainIds.size() <= 50));
    }

    // Customers, problems, ideas and features: cards on the board (D-037, D-040).
    function validCard(d) {
      return isText(d.title, 200)
        && optText(d, 'body', 20000)
        && optText(d, 'color', 20)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && d.x is number && d.y is number
        && optIn(d, 'validation', ['hypothesis', 'testing', 'validated', 'invalidated'])
        && validDomainRefs(d);
    }

    // What was learned, on a customer, problem or idea (D-137).
    function validEvidence(d) {
      return isText(d.nodeId, 128)
        && d.nodeType in ['customer', 'problem', 'idea']
        && d.kind in ['interview', 'quote', 'data', 'observation', 'link']
        && isText(d.text, 2000) && d.text.size() > 0
        && d.stance in ['supports', 'contradicts']
        && optText(d, 'source', 200)
        && optText(d, 'url', 2000)
        && (!('date' in d) || (d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && d.createdAt is number;
    }

    function validFeature(d) {
      return validCard(d)
        && optIn(d, 'priority', ['P1', 'P2', 'P3'])
        && optIn(d, 'status', ['idea', 'planned', 'building', 'shipped'])
        && optIn(d, 'effort', ['S', 'M', 'L'])
        && optIn(d, 'impact', ['low', 'medium', 'high'])
        // What it must do (D-133): a short list; the cells score against it.
        && (!('criteria' in d) || (d.criteria is list && d.criteria.size() <= 8));
    }

    function validCompetitor(d) {
      return isText(d.name, 200)
        && optText(d, 'url', 2000)
        && optText(d, 'description', 20000)
        && optText(d, 'pricing', 2000)
        && optText(d, 'audience', 2000)
        && optText(d, 'notes', 20000)
        && optText(d, 'color', 20)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        // Where it operates (D-145).
        && (!('regions' in d) || (d.regions is list && d.regions.size() <= 20))
        && (!('x' in d) || d.x is number)
        && (!('y' in d) || d.y is number)
        && validDomainRefs(d);
    }

    // Text on the board, and a place to jump to (D-050). A section (D-130) is a frame with a name: x/y its centre, w/h its size.
    function optSize(d, key) {
      return !(key in d) || (d[key] is number && d[key] > 0 && d[key] <= 2000);
    }

    function optBool(d, key) {
      return !(key in d) || d[key] is bool;
    }

    function validLabel(d) {
      return isText(d.text, 200)
        && optText(d, 'color', 20)
        && optIn(d, 'size', ['heading', 'subheading', 'minor', 'note'])
        && optBool(d, 'bold') && optBool(d, 'italic') && optBool(d, 'caps')
        && optIn(d, 'kind', ['title', 'section'])
        && optSize(d, 'w') && optSize(d, 'h')
        && (!('kind' in d) || d.kind != 'section' || ('w' in d && 'h' in d))
        && optText(d, 'planeId', 128)
        && d.x is number && d.y is number;
    }

    // A package (D-141): a card holding a piece of the chain by id, laid out on its home plane.
    function validPackage(d) {
      return validCard(d)
        && d.memberIds is list && d.memberIds.size() <= 60
        && isText(d.homePlaneId, 128)
        && optIn(d, 'impact', ['low', 'medium', 'high'])
        && optIn(d, 'effort', ['S', 'M', 'L']);
    }

    // A plane (D-139): a name and its place in the list.
    function validPlane(d) {
      return isText(d.name, 80) && d.name.size() > 0
        && d.order is number
        && d.createdAt is number;
    }

    // A card's place on a plane (D-139): the id is fixed by the two.
    function validPlacement(id, d) {
      return isText(d.planeId, 128)
        && isText(d.itemId, 128)
        && id == d.planeId + '_' + d.itemId
        && d.itemType in ['customer', 'problem', 'idea', 'feature', 'competitor', 'package']
        && d.x is number && d.y is number;
    }

    function validCompetitorFeature(d) {
      return isText(d.competitorId, 128)
        && isText(d.name, 200)
        && optText(d, 'description', 20000)
        && optText(d, 'category', 100);
    }

    // One matrix cell per (feature, competitor): the id is fixed by its two ends.
    function validComparison(id, d) {
      return isText(d.featureId, 128)
        && isText(d.competitorId, 128)
        && id == d.featureId + '_' + d.competitorId
        && optIn(d, 'coverage', ['none', 'partial', 'full', 'better'])
        && optText(d, 'notes', 20000)
        && optText(d, 'competitorFeatureId', 128)
        // Criterion id → score (D-133).
        && (!('criteria' in d) || (d.criteria is map && d.criteria.size() <= 8
          && d.criteria.values().hasOnly(['met', 'part', 'no'])))
        // Not comparable at all, and how sure the cell is (D-136).
        && optBool(d, 'notRelevant')
        && optIn(d, 'confidence', ['documented', 'inferred', 'guess']);
    }

    function validEdge(d) {
      let types = ['customer', 'problem', 'idea', 'feature', 'competitor', 'competitorFeature', 'package'];
      return isText(d.fromId, 128) && isText(d.toId, 128) && d.fromId != d.toId
        && d.fromType in types && d.toType in types
        && isText(d.kind, 40)
        && optText(d, 'label', 200)
        && (!('bends' in d) || (d.bends is list && d.bends.size() <= 8));
    }

    // A file on an item (D-083): the metadata here, the file in Storage (storage.rules) at `path`.
    // `uid` is who attached it; not tied to the writer, since undoing a delete restores someone else's attachment.
    function validAttachment(wid, id, d) {
      return isText(d.nodeId, 128)
        && d.nodeType in ['customer', 'problem', 'idea', 'feature', 'competitor', 'competitorFeature']
        && isText(d.name, 200) && d.name.size() > 0
        && d.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/svg+xml', 'application/pdf']
        && d.size is int && d.size >= 0 && d.size < 10 * 1024 * 1024
        && isText(d.path, 400)
        && d.path.matches('workspaces/' + wid + '/attachments/' + id + '/[^/]+')
        && (!('thumbPath' in d) || d.thumbPath == 'workspaces/' + wid + '/attachments/' + id + '/~thumb.webp')
        && (!('width' in d) || d.width is number)
        && (!('height' in d) || d.height is number)
        && isText(d.uid, 128)
        && d.createdAt is number;
    }

    function valid(wid, collection, id, d) {
      return (collection == 'labels' && validLabel(d))
        || (collection == 'customers' && validCard(d))
        || (collection == 'problems' && validCard(d))
        || (collection == 'ideas' && validCard(d))
        || (collection == 'features' && validFeature(d))
        || (collection == 'competitors' && validCompetitor(d))
        || (collection == 'competitorFeatures' && validCompetitorFeature(d))
        || (collection == 'comparisons' && validComparison(id, d))
        || (collection == 'edges' && validEdge(d))
        || (collection == 'attachments' && validAttachment(wid, id, d))
        || (collection == 'evidence' && validEvidence(d))
        || (collection == 'packages' && validPackage(d))
        || (collection == 'planes' && validPlane(d))
        || (collection == 'placements' && validPlacement(id, d));
    }

    match /workspaces/{wid} {
      // Invited people see the workspace doc (name, member count) to accept or decline, not its content.
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds || invited(resource.data));

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.inviteCode is string
        && optText(request.resource.data, 'description', 1000);

      allow update: if editing() || joiningByInvite() || decliningInvite() || leaving() || ownerManaging();

      allow delete: if roleIn(resource.data) == 'owner';

      // Owners and editors rename it and say what it's building.
      function editing() {
        return roleIn(resource.data) in ['owner', 'editor']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
          && optText(request.resource.data, 'description', 1000);
      }

      // Owners manage members, roles and the invite code (D-098): any role for anyone, themselves included, as long as
      // someone still owns it. The creator (`ownerId`) never changes.
      function ownerManaging() {
        return roleIn(resource.data) == 'owner'
          && request.resource.data.ownerId == resource.data.ownerId
          && validRoles(request.resource.data)
          && optText(request.resource.data, 'description', 1000)
          && (!('invitedEmails' in request.resource.data)
            || (request.resource.data.invitedEmails is list && request.resource.data.invitedEmails.size() <= 100));
      }

      // Accept an email invite (D-062): add only yourself, as editor, and use up your invite.
      // A code alone no longer joins anyone; it only sends a request the owner approves (joinRequests below).
      function joiningByInvite() {
        return invited(resource.data)
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'invitedEmails'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == 'editor'
          && request.resource.data.invitedEmails == resource.data.invitedEmails.removeAll([myEmail()]);
      }

      // Turn an invite down: remove only your own address.
      function decliningInvite() {
        return invited(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedEmails'])
          && request.resource.data.invitedEmails == resource.data.invitedEmails.removeAll([myEmail()]);
      }

      // Anyone removes only themselves, as long as someone still owns it (the last owner deletes it instead).
      function leaving() {
        return signedIn()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.roles.values().hasAny(['owner'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.roles);
      }

      // The assistant's workspace key settings (D-079). Members read them (is there a key, may I use it); the owner picks
      // who may use it. hasKey / keyHint are written only by the setWorkspaceKey function, never by a client.
      match /ai/{docId} {
        function validAccess(d) {
          return (!('access' in d) || d.access in ['everyone', 'chosen'])
            && (!('allowed' in d) || (d.allowed is list && d.allowed.size() <= 100));
        }
        // The owners' model per task on the workspace key, and the others members may pick (D-104).
        function validModels(d) {
          return (!('models' in d) || (d.models is map
              && d.models.keys().hasOnly(['chat', 'research', 'deep'])
              && (!('chat' in d.models) || isText(d.models.chat, 100))
              && (!('research' in d.models) || isText(d.models.research, 100))
              && (!('deep' in d.models) || isText(d.models.deep, 100))))
            && (!('allowedModels' in d) || (d.allowedModels is list && d.allowedModels.size() <= 20));
        }
        allow read: if isMember(wid);
        allow create: if docId == 'config' && isOwner(wid)
          && request.resource.data.keys().hasOnly(['access', 'allowed', 'models', 'allowedModels'])
          && validAccess(request.resource.data) && validModels(request.resource.data);
        allow update: if docId == 'config' && isOwner(wid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access', 'allowed', 'models', 'allowedModels'])
          && validAccess(request.resource.data) && validModels(request.resource.data);
      }

      // What each assistant call used (D-079): time, task, model, tokens, searches; never the messages.
      // Append-only. You log your own-key calls; workspace-key calls are logged by the server.
      // You see your own entries; the owner also sees everyone's workspace-key entries, never someone's own-key ones.
      match /aiUsage/{id} {
        function count(v) {
          return v is int && v >= 0;
        }
        allow create: if isMember(wid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'keySource', 'task', 'model', 'inputTokens', 'cachedTokens', 'outputTokens', 'reasoningTokens', 'webSearches', 'tools', 'status', 'ms', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keySource == 'own'
          && isText(request.resource.data.name, 200)
          && request.resource.data.task in ['chat', 'research']
          && isText(request.resource.data.model, 100)
          && count(request.resource.data.inputTokens) && count(request.resource.data.cachedTokens)
          && count(request.resource.data.outputTokens) && count(request.resource.data.reasoningTokens)
          && count(request.resource.data.webSearches) && count(request.resource.data.ms)
          && request.resource.data.tools is list && request.resource.data.tools.size() <= 10
          && request.resource.data.status in ['done', 'stopped', 'failed']
          && request.resource.data.at is int && request.resource.data.at <= request.time.toMillis() + 60000;
        allow read: if signedIn()
          && (resource.data.uid == request.auth.uid
            || (resource.data.keySource == 'workspace' && isOwner(wid)));
      }

      // Research reports (D-090). Saved by whoever ran them and seen only by them until they share it; then every member
      // reads it. Only the author shares or unshares it, and nothing else in it changes. The author deletes it; an owner
      // may delete a shared one. Undoing an owner's delete restores someone else's shared report, so owners may create that too.
      // D-098: the doc is a summary (title, answer, counts) and the rest is in content/body. Reports saved before that hold
      // everything in one doc; they stay readable, shareable and deletable, and undoing their delete may restore them.
      // Shapes mirror ReportSummary / ReportBody and REPORT_LIMITS in src/data/model.ts.
      match /reports/{id} {
        function validMeta(d) {
          return optIn(d, 'kind', ['research', 'chat', 'upload'])
            && isText(d.title, 300) && isText(d.answer, 4000)
            && isText(d.topic, 500) && isText(d.uid, 128) && isText(d.name, 200) && isText(d.model, 100)
            && d.shared is bool
            && d.createdAt is number;
        }
        function validBody(d) {
          return d.sections is list && d.sections.size() <= 30
            && d.implications is list && d.implications.size() <= 20
            && d.openQuestions is list && d.openQuestions.size() <= 30
            && d.sources is list && d.sources.size() <= 200;
        }
        function validSummary(d) {
          return d.keys().hasOnly(['kind', 'title', 'answer', 'topic', 'uid', 'name', 'model', 'shared', 'createdAt', 'sectionCount', 'sourceCount'])
            && validMeta(d)
            && d.sectionCount is int && d.sectionCount >= 0
            && d.sourceCount is int && d.sourceCount >= 0;
        }
        function validWhole(d) {
          return d.keys().hasOnly(['kind', 'title', 'answer', 'sections', 'implications', 'openQuestions', 'sources', 'topic', 'uid', 'name', 'model', 'shared', 'createdAt'])
            && validMeta(d) && validBody(d);
        }
        function mayRead(d) {
          return isMember(wid) && (d.shared == true || d.uid == request.auth.uid);
        }
        // A report not saved yet reads as missing to any member: the chat listens for it before you save it, and a
        // listener refused once never comes back, so the save would go unseen and a second one be refused as an edit.
        allow read: if resource == null ? isMember(wid) : mayRead(resource.data);
        allow create: if isMember(wid) && (validSummary(request.resource.data) || validWhole(request.resource.data))
          && (request.resource.data.uid == request.auth.uid || (request.resource.data.shared == true && isOwner(wid)));
        allow update: if isMember(wid) && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared'])
          && request.resource.data.shared is bool;
        allow delete: if isMember(wid) && (resource.data.uid == request.auth.uid || (resource.data.shared == true && isOwner(wid)));

        // The body follows its summary: read by whoever reads the report, written with it (the summary in the same
        // batch, hence getAfter), deleted by whoever may delete it.
        function summary() {
          return get(/databases/$(database)/documents/workspaces/$(wid)/reports/$(id)).data;
        }
        function summaryAfter() {
          return getAfter(/databases/$(database)/documents/workspaces/$(wid)/reports/$(id)).data;
        }
        match /content/{part} {
          allow read: if part == 'body' && mayRead(summary());
          allow create: if part == 'body' && isMember(wid)
            && request.resource.data.keys().hasOnly(['sections', 'implications', 'openQuestions', 'sources'])
            && validBody(request.resource.data)
            && (summaryAfter().uid == request.auth.uid || (summaryAfter().shared == true && isOwner(wid)));
          allow delete: if part == 'body' && isMember(wid)
            && (!exists(/databases/$(database)/documents/workspaces/$(wid)/reports/$(id))
              || summary().uid == request.auth.uid || (summary().shared == true && isOwner(wid)));
        }
      }

      // Who is in the workspace, by name (D-098). Each member writes their own entry; owners write one when they let
      // someone in, and remove it with them. Their role lives on the workspace doc.
      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['name', 'email', 'photo', 'joinedAt'])
            && isText(d.name, 200)
            && optText(d, 'email', 320)
            && optText(d, 'photo', 2000)
            && d.joinedAt is number;
        }
        allow read: if isMember(wid);
        allow create, update: if validMember(request.resource.data)
          && ((request.auth.uid == uid && isMember(wid)) || isOwner(wid));
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(wid));
      }

      // Workspace content: members read it, owners and editors change it (D-098); known collections only, with a sane shape.
      // Shapes mirror src/data/model.ts; change both together.
      match /{collection}/{docId} {
        // `domains` and `groups` are retired (D-048, D-049): still readable and deletable so old workspaces can be cleaned up.
        function known() {
          return collection in ['labels', 'customers', 'problems', 'ideas', 'features', 'competitors', 'competitorFeatures', 'comparisons', 'edges', 'attachments', 'evidence', 'planes', 'placements', 'packages', 'domains', 'groups'];
        }
        allow read: if isMember(wid) && known();
        allow delete: if canEdit(wid) && known();
        allow create, update: if canEdit(wid) && valid(wid, collection, docId, request.resource.data);
      }
    }

    // A workspace's OpenAI key, encrypted (D-079). Only the Cloud Functions (admin) read or write it; no client ever can.
    match /aiSecrets/{wid} {
      allow read, write: if false;
    }

    // Lookup by exact code only; codes can't be listed or enumerated.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if roleIn(workspaceAfter(request.resource.data.workspaceId)) == 'owner'
        && workspaceAfter(request.resource.data.workspaceId).inviteCode == code
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOwner(resource.data.workspaceId);
    }

    // Asking to join with a code (D-062). The id is `<workspaceId>_<uid>`: one request per person per workspace.
    // An owner approves (adds the member and deletes the request in one batch) or denies (deletes it). Since D-098 any
    // owner settles them, querying by workspace; `ownerId` (the creator) is still copied in.
    match /joinRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['workspaceId', 'ownerId', 'uid', 'name', 'email', 'code', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.workspaceId + '_' + request.auth.uid
        && request.resource.data.code == workspace(request.resource.data.workspaceId).inviteCode
        && request.resource.data.ownerId == workspace(request.resource.data.workspaceId).ownerId
        && !(request.auth.uid in workspace(request.resource.data.workspaceId).memberIds)
        && request.resource.data.email == request.auth.token.email
        && isText(request.resource.data.name, 200)
        && request.resource.data.createdAt is number;
      // The requester sees and withdraws their own; the workspace's owners see and settle them.
      allow read, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner(resource.data.workspaceId));
    }
  }
}
