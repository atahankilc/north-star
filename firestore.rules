rules_version = '2';

// Security for all persistent data. The client is never trusted (CLAUDE.md).
// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function workspace(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    // State after the current batch; used when a workspace and its code are created together.
    function workspaceAfter(wid) {
      return getAfter(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    function isMember(wid) {
      return signedIn() && request.auth.uid in workspace(wid).memberIds;
    }

    // ---- Workspace content shapes ----

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function optText(d, key, max) {
      return !(key in d) || isText(d[key], max);
    }

    function optIn(d, key, values) {
      return !(key in d) || d[key] in values;
    }

    // Domains are retired (D-048); older items may still carry these fields, so they're tolerated, not required.
    function validDomainRefs(d) {
      return optText(d, 'domainId', 128)
        && (!('domainIds' in d) || (d.domainIds is list && d.domainIds.size() <= 50));
    }

    // Customers, problems, ideas and features: cards on the board (D-037, D-040).
    function validCard(d) {
      return isText(d.title, 200)
        && optText(d, 'body', 20000)
        && optText(d, 'color', 20)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && d.x is number && d.y is number
        && validDomainRefs(d);
    }

    function validFeature(d) {
      return validCard(d)
        && optIn(d, 'priority', ['P1', 'P2', 'P3'])
        && optIn(d, 'status', ['idea', 'planned', 'building', 'shipped'])
        && optIn(d, 'effort', ['S', 'M', 'L']);
    }

    function validCompetitor(d) {
      return isText(d.name, 200)
        && optText(d, 'url', 2000)
        && optText(d, 'description', 20000)
        && optText(d, 'pricing', 2000)
        && optText(d, 'audience', 2000)
        && optText(d, 'notes', 20000)
        && optText(d, 'color', 20)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && (!('x' in d) || d.x is number)
        && (!('y' in d) || d.y is number)
        && validDomainRefs(d);
    }

    // Text on the board, and a place to jump to (D-050).
    function validLabel(d) {
      return isText(d.text, 200)
        && optText(d, 'color', 20)
        && d.x is number && d.y is number;
    }

    function validCompetitorFeature(d) {
      return isText(d.competitorId, 128)
        && isText(d.name, 200)
        && optText(d, 'description', 20000)
        && optText(d, 'category', 100);
    }

    // One matrix cell per (feature, competitor): the id is fixed by its two ends.
    function validComparison(id, d) {
      return isText(d.featureId, 128)
        && isText(d.competitorId, 128)
        && id == d.featureId + '_' + d.competitorId
        && optIn(d, 'coverage', ['none', 'partial', 'full', 'better'])
        && optText(d, 'notes', 20000)
        && optText(d, 'competitorFeatureId', 128);
    }

    function validEdge(d) {
      let types = ['customer', 'problem', 'idea', 'feature', 'competitor', 'competitorFeature'];
      return isText(d.fromId, 128) && isText(d.toId, 128) && d.fromId != d.toId
        && d.fromType in types && d.toType in types
        && isText(d.kind, 40)
        && optText(d, 'label', 200);
    }

    function valid(collection, id, d) {
      return (collection == 'labels' && validLabel(d))
        || (collection == 'customers' && validCard(d))
        || (collection == 'problems' && validCard(d))
        || (collection == 'ideas' && validCard(d))
        || (collection == 'features' && validFeature(d))
        || (collection == 'competitors' && validCompetitor(d))
        || (collection == 'competitorFeatures' && validCompetitorFeature(d))
        || (collection == 'comparisons' && validComparison(id, d))
        || (collection == 'edges' && validEdge(d));
    }

    match /workspaces/{wid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.inviteCode is string;

      allow update: if editing() || joining() || leaving() || ownerManaging();

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Members edit content fields only.
      function editing() {
        return signedIn()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description']);
      }

      // Owner manages members, roles and the invite code, but can't orphan the workspace.
      function ownerManaging() {
        return signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.roles[request.auth.uid] == 'owner';
      }

      // Join with an invite code (D-012): add only yourself, and prove the code.
      function joining() {
        return signedIn()
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'joinCode'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == 'editor'
          && request.resource.data.joinCode == resource.data.inviteCode;
      }

      // A non-owner removes only themselves. Owners delete the workspace instead.
      function leaving() {
        return signedIn()
          && request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.roles);
      }

      // Workspace content: members only, known collections only, with a sane shape.
      // Shapes mirror src/data/model.ts; change both together.
      match /{collection}/{docId} {
        // `domains` and `groups` are retired (D-048, D-049): still readable and deletable so old workspaces can be cleaned up.
        allow read, delete: if isMember(wid) && collection in ['labels', 'customers', 'problems', 'ideas', 'features', 'competitors', 'competitorFeatures', 'comparisons', 'edges', 'domains', 'groups'];
        allow create, update: if isMember(wid) && valid(collection, docId, request.resource.data);
      }
    }

    // Lookup by exact code only; codes can't be listed or enumerated.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && workspaceAfter(request.resource.data.workspaceId).ownerId == request.auth.uid
        && workspaceAfter(request.resource.data.workspaceId).inviteCode == code
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && workspace(resource.data.workspaceId).ownerId == request.auth.uid;
    }
  }
}
