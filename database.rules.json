{
  "rules": {
    "access": {
      "$wid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "docAccess": {
      "$wid": {
        "$id": {
          ".read": "auth != null && root.child('access').child($wid).child(auth.uid).exists()"
        }
      }
    },
    "presence": {
      "$wid": {
        ".read": "auth != null && root.child('access').child($wid).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('access').child($wid).child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['name', 'color', 'view', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "photo": {
            ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https:\\/\\/([a-z0-9-]+\\.)*googleusercontent\\.com\\//)"
          },
          "view": {
            ".validate": "newData.val() === 'canvas'"
          },
          "plane": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "canvas": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "x": {
            ".validate": "newData.isNumber()"
          },
          "y": {
            ".validate": "newData.isNumber()"
          },
          "sel": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "more": {
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "drag": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "tasks": {
            ".validate": "newData.isString() && newData.val().length <= 140"
          },
          "away": {
            ".validate": "newData.val() === true"
          },
          "doc": {
            ".validate": "newData.hasChildren(['id'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "h": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "$other": {
              ".validate": false
            }
          },
          "since": {
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "live": {
      "$wid": {
        "$id": {
          ".read": "auth != null && root.child('access').child($wid).child(auth.uid).exists() && (root.child('docAccess').child($wid).child($id).child('shared').val() === true || root.child('docAccess').child($wid).child($id).child('uid').val() === auth.uid)",
          "state": {
            ".write": "newData.exists() && auth != null && root.child('access').child($wid).child(auth.uid).exists() && root.child('docAccess').child($wid).child($id).child('kind').val() === 'markdown' && $id !== 'agent-notes' && (root.child('docAccess').child($wid).child($id).child('uid').val() === auth.uid || (root.child('docAccess').child($wid).child($id).child('shared').val() === true && (root.child('access').child($wid).child(auth.uid).val() === 'owner' || root.child('access').child($wid).child(auth.uid).val() === 'editor')))",
            ".validate": "newData.hasChildren(['s', 'v', 'at']) && (data.exists() ? newData.child('v').val() === data.child('v').val() + 1 : newData.child('v').val() === 0)",
            "s": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1228800"
            },
            "v": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          "edits": {
            "$eid": {
              ".write": "auth != null && root.child('access').child($wid).child(auth.uid).exists() && root.child('docAccess').child($wid).child($id).child('kind').val() === 'markdown' && $id !== 'agent-notes' && (root.child('docAccess').child($wid).child($id).child('uid').val() === auth.uid || (root.child('docAccess').child($wid).child($id).child('shared').val() === true && (root.child('access').child($wid).child(auth.uid).val() === 'owner' || root.child('access').child($wid).child(auth.uid).val() === 'editor'))) && (!newData.exists() || !data.exists())",
              ".validate": "newData.hasChildren(['u', 'by', 'at'])",
              "u": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 87384"
              },
              "by": {
                ".validate": "newData.val() === auth.uid"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "agentLive": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "agentCtl": {
      "$uid": {
        "$run": {
          ".read": "auth != null && auth.uid === $uid",
          "stop": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === true"
          },
          "here": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === now"
          },
          "view": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "words": {
            "$id": {
              ".write": "auth != null && auth.uid === $uid && newData.exists() && !data.exists()",
              ".validate": "newData.hasChildren(['text', 'at'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20000"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "done": {
            "$id": {
              ".write": "auth != null && auth.uid === $uid && newData.exists() && !data.exists()",
              ".validate": "newData.val() === true || (newData.isString() && newData.val().length <= 300)"
            }
          },
          "after": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
