+<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Yüzeyler (Q-035)</title>
+<style>
+:root{color-scheme:dark}*{box-sizing:border-box}
+body{margin:0;background:#000;color:#e8e8e8;font:14px/1.45 -apple-system,Inter,sans-serif}
+body[data-t=light]{background:#f3f3f3;color:#111}
+aside{position:fixed;inset:0 auto 0 0;width:330px;overflow:auto;padding:16px 16px 24px;background:#0c0c0d;box-shadow:1px 0 0 #8884}
+body[data-t=light] aside{background:#fff}
+main{margin-left:330px;min-width:0;padding-bottom:60vh}
+fieldset{all:unset;display:block;margin-bottom:14px;padding:8px;border-radius:14px}
+fieldset[data-cur=true]{background:#8881}
+.h{display:flex;align-items:center;gap:8px;font-weight:600;font-size:14px;cursor:pointer}
+.h b{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#2fd9e0;color:#000;font-size:12px;flex:none}
+.what{margin:2px 0 6px 28px;font-size:12.5px;opacity:.65}
+button{all:unset;box-sizing:border-box;display:block;width:100%;padding:6px 10px 6px 28px;margin-top:2px;border-radius:12px;cursor:pointer;font-size:13.5px;position:relative}
+button::before{content:'';position:absolute;left:10px;top:11px;width:9px;height:9px;border-radius:50%;box-shadow:inset 0 0 0 1px #8889}
+button i{display:block;font-style:normal;font-size:12px;opacity:.65}
+button:hover{background:#8882}
+button[data-on=true]{background:#2fd9e022}
+button[data-on=true]::before{background:#2fd9e0;box-shadow:0 0 6px #2fd9e0}
+button:focus-visible{outline:2px solid #2fd9e0;outline-offset:-2px}
+.row{display:flex;gap:4px}.row button{padding-right:6px}
+a{color:inherit;opacity:.75;font-size:13px}
+h2{font:500 12px ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.05em;margin:0;padding:28px 24px 12px;color:#ff3d9a;display:flex;gap:10px;align-items:baseline}
+h2 span{color:inherit;opacity:.6;text-transform:none;letter-spacing:0;font-family:inherit}
+section{scroll-margin-top:0}
+.grid{display:grid;gap:16px;padding:0 24px 8px;grid-template-columns:repeat(auto-fit,minmax(480px,1fr))}
+figure{margin:0}figure.w{grid-column:1/-1}figcaption{opacity:.7;margin-bottom:6px;font-size:13px}
+iframe{display:block;width:100%;border:0;background:#0000;border-radius:6px;box-shadow:0 0 0 1px #8883}
+</style></head><body>
+<aside id="side"></aside>
+<main id="rest"></main>
+<script type="module">
+const KEY='q035-demo-6'
+const FIXED={modal:'line',hazard:'ring',mark:'tick',panel:'under',drop:'line',dock:'line',box:'round',thread:'tab'}
+const st={small:'pill',theme:'dark',...JSON.parse(sessionStorage.q035f||'{}'),...FIXED}
+const GROUPS=[
+['small','1','Bildirim ve açıklama','Değişen: bildirimin (toast) ve kelime açıklamasının (tip) köşeleri. Önizlemede bildirim kaybolmuyor, açıklama kendiliğinden açık',[
+ ['now','Bugün','İkisi de dik köşeli'],
+ ['pill','Hap','Bildirim tam yuvarlak uçlu; açıklama büyük yuvarlak köşeli'],
+ ['round','Yuvarlak köşeli','İkisi de küçük yuvarlak köşeli (8 px), uçları düz']]],
+]
+const SEC={
+small:[['toast|with-action','Bildirim, düğmeli',200],['toast|long','Bildirim, uzun',200],['tip|in-a-line','Açıklama',240,1]],
+}
+const cur=()=>{const {theme,...p}=st;return p}
+const send=()=>{localStorage.setItem(KEY,JSON.stringify(cur()));sessionStorage.q035f=JSON.stringify(st);document.querySelectorAll('iframe').forEach(f=>f.contentWindow?.postMessage({round:cur()},'*'))}
+const side=document.getElementById('side')
+side.innerHTML='<div style="font-weight:600;font-size:15px;margin:0 8px 2px">Yüzeyler</div><div style="font-size:12.5px;opacity:.65;margin:0 8px 12px">Son konu. Bir seçeneğe basınca sağdaki örnekler hemen değişir. Karar verilenler sabit: modal yuvarlak ve çizgili, silme onayında yuvarlağı izleyen ╱╱╱, köşeye uyan kısa yay işaretleri, altından çıkan yan panel, yuvarlak çizgili menü, çizgili sekme dock, Settings’te yuvarlak çizgili kutular, çizgili sekme yorumlar kutusu.</div>'
+for(const[key,n,title,what,opts]of GROUPS){const fs=document.createElement('fieldset');fs.dataset.k=key;fs.innerHTML=`<div class="h"><b>${n}</b>${title}</div><div class="what">${what}</div>`
+fs.querySelector('.h').onclick=()=>show(key)
+for(const[v,t,d]of opts){const b=document.createElement('button');b.dataset.v=v;b.innerHTML=t+(d?`<i>${d}</i>`:'');b.onclick=()=>pick(key,v);fs.append(b)}side.append(fs)}
+const tf=document.createElement('fieldset');tf.dataset.k='theme';tf.innerHTML='<div class="h">Tema</div><div class="row"></div>';for(const[v,t]of[['dark','Koyu'],['light','Açık']]){const b=document.createElement('button');b.dataset.v=v;b.textContent=t;b.onclick=()=>pick('theme',v);tf.querySelector('.row').append(b)}side.append(tf)
+const paint=()=>side.querySelectorAll('fieldset').forEach(fs=>{fs.querySelectorAll('button').forEach(b=>b.dataset.on=b.dataset.v===st[fs.dataset.k]);fs.dataset.cur=fs.dataset.k===at})
+let at='small'
+function show(key){at=key;paint();document.getElementById('sec-'+key)?.scrollIntoView({behavior:'smooth',block:'start'})}
+function pick(key,v){st[key]=v;if(key==='theme'){document.body.dataset.t=v;paint();send();load();return}send();show(key);if(key==='none')document.querySelectorAll('#sec-small iframe').forEach(i=>{i.src='about:blank';setTimeout(()=>{i.src=addr(i.dataset.c,i.dataset.m)},50)})}
+document.body.dataset.t=st.theme
+const addr=(c,m)=>`/gallery.html?round=${encodeURIComponent(JSON.stringify(cur()))}#c=${c.split('|')[0]}${c.includes('|')?'&s='+c.split('|')[1]:''}&theme=${st.theme}${m==='full'?'':'&motion=reduced'}&alone`
+function load(){const q=[];const r=document.getElementById('rest');r.innerHTML=''
+for(const[key,n,title,what]of GROUPS){const s=document.createElement('section');s.id='sec-'+key;s.innerHTML=`<h2>${n} · ${title}<span>${what}</span></h2>`;const g=document.createElement('div');g.className='grid'
+for(const[c,name,hh,w,m]of SEC[key]){const f=document.createElement('figure');if(w)f.className='w';f.innerHTML=`<figcaption>${name}</figcaption><iframe title="${name}" style="height:${hh}px"></iframe>`;const i=f.querySelector('iframe');i.dataset.c=c;i.dataset.m=m||'';q.push(i);g.append(f)}
+s.append(g);r.append(s)}
+const tell=i=>i.contentWindow?.postMessage({round:cur()},'*')
+const next=()=>{const i=q.shift();if(!i)return;i.onload=()=>{tell(i);setTimeout(()=>tell(i),1500);setTimeout(()=>tell(i),4000);setTimeout(next,200)};i.src=addr(i.dataset.c,i.dataset.m)};next();next();next()}
+// Which group's examples are on screen: its options are the ones lit in the list.
+addEventListener('scroll',()=>{let best=at;for(const[key]of GROUPS){const el=document.getElementById('sec-'+key);if(el&&el.getBoundingClientRect().top<innerHeight*0.4)best=key}if(best!==at){at=best;paint()}},{passive:true})
+paint();send();load()
+</script></body></html>
