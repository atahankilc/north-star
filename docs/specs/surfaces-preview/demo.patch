+// Throwaway preview for Q-035: other ways to draw the surfaces (modals, dropdowns, docked panels, docks, boxes), laid
+// over the real CSS. Controls, cards and pieces are left alone. Never lands in the repo.
+import win from './ui/patterns/Window.module.css'
+import menu from './ui/patterns/Menu.module.css'
+import popover from './ui/patterns/Popover.module.css'
+import toast from './ui/patterns/Toast.module.css'
+import tip from './ui/patterns/Tip.module.css'
+import panel from './ui/patterns/PromptPanel.module.css'
+import column from './ui/patterns/EdgeColumn.module.css'
+import consoleCss from './ui/patterns/Console.module.css'
+import frame from './ui/foundation/Frame.module.css'
+import settings from './ui/patterns/Settings.module.css'
+import hazard from './ui/patterns/HazardConfirm.module.css'
+import promptFrame from './ui/foundation/PromptFrame.module.css'
+import row from './ui/primitives/PromptRow.module.css'
+import threads from './views/workspace/threads/Threads.module.css'
+import marks from './ui/primitives/Marks.module.css'
+import face from './views/workspace/cards/CardFace.module.css'
+import plane from './views/workspace/plane/PlaneCards.module.css'
+
+export const KEY = 'q035-demo-6'
+const dot = (x?: string) => '.' + (x ?? 'nope').split(' ')[0]
+const W = `:is(${dot(win.window)},${dot(settings.dialog)})`
+const HZ = dot(hazard.box)
+const H = dot(promptFrame.frame)
+const POP = dot(popover.popover)
+const MP = dot(menu.panel)
+const PAN = dot(panel.panel)
+const R = dot(row.row)
+const COL = dot(column.column)
+const CON = dot(consoleCss.console)
+const FL = dot(consoleCss.floor)
+const SEC = dot(settings.section)
+const NAV = dot(settings.navItem)
+const FR = `:is(${dot(frame.frame)},${dot(frame.dashed)},${dot(frame.interactive)})`
+const TOAST = dot(toast.toast)
+const TIP = dot(tip.tip)
+const INBOX = dot(threads.inbox)
+const MK = dot(marks.marks)
+
+const shade = `var(--q-shade)`
+const edge = `0 0 0 1px var(--line)`
+const a = (k: string, v: string) => `:root[data-${k}='${v}']`
+const raised = `--bg:var(--bg-raised);background:var(--bg-raised)`
+
+const CSS = `
+:root{--q-shade:0 18px 48px rgb(0 0 0/.55),0 2px 8px rgb(0 0 0/.35)}
+:root[data-theme='light']{--q-shade:0 18px 48px rgb(0 0 0/.16),0 2px 8px rgb(0 0 0/.10)}
+
+/* ── 1 modal ── */
+${a('modal', 'soft')} :is(${W},${HZ}){${raised};border:0;border-radius:24px;box-shadow:${edge},${shade};overflow:hidden}
+${a('modal', 'line')} :is(${W},${HZ}){border-radius:24px;overflow:hidden}
+${a('modal', 'cut')} :is(${W},${HZ}){${raised};border:0;border-radius:28px 28px 28px 0;box-shadow:${edge},${shade};overflow:hidden}
+:root:not([data-modal='now']) ${HZ}{border-top-width:var(--line-w)}
+
+/* ── 2 dropdown ── */
+:root{--q-dr:16px;--q-ds:9px;--q-corners:linear-gradient(#000 0 0) left top/var(--q-ds) var(--q-ds) no-repeat,linear-gradient(#000 0 0) right top/var(--q-ds) var(--q-ds) no-repeat,linear-gradient(#000 0 0) left bottom/var(--q-ds) var(--q-ds) no-repeat,linear-gradient(#000 0 0) right bottom/var(--q-ds) var(--q-ds) no-repeat}
+:root:not([data-drop='now']) :is(${H},${POP}){border-radius:var(--q-dr);corner-shape:squircle}
+:root:not([data-drop='now']) ${PAN}{padding:4px}
+:root:not([data-drop='now']) ${R}{box-shadow:none!important;border-radius:999px}
+:root:not([data-drop='now']) ${R}[data-picked]{background:color-mix(in srgb,var(--tone,var(--accent-cyan)) 22%,transparent)}
+:root:not([data-drop='now']) ${R}[data-danger][data-picked]{background:color-mix(in srgb,var(--diff-deleted) 24%,transparent)}
+:root:is([data-drop='line'],[data-drop='touch']) ${H}{box-shadow:0 0 0 1px var(--line-hover),var(--feather) color-mix(in srgb,var(--bg) var(--mix-strong),transparent)}
+:root:is([data-drop='line'],[data-drop='touch']) ${H}:focus-within{box-shadow:0 0 0 1px var(--accent-cyan),var(--feather) color-mix(in srgb,var(--bg) var(--mix-strong),transparent)}
+:root:is([data-drop='line'],[data-drop='touch']) ${H}::after{content:none}
+${a('drop', 'mark')} ${H}::after{background:none;border:var(--line-w) solid var(--mk);border-radius:var(--q-dr);corner-shape:squircle;-webkit-mask:var(--q-corners);mask:var(--q-corners)}
+${a('drop', 'touch')} :is(${H},${POP}){border-radius:0 var(--q-dr) var(--q-dr) var(--q-dr)}
+${a('drop', 'touch')} ${MP}[data-up='true'] ${H}{border-radius:var(--q-dr) var(--q-dr) var(--q-dr) 0}
+${a('drop', 'touch')} :is(${MP}[data-right='true'],${MP}[data-end='true']) ${H}{border-radius:var(--q-dr) 0 var(--q-dr) var(--q-dr)}
+
+/* ── 3 docked panel ── */
+:root:is([data-panel='touch'],[data-panel='isle']) ${COL}{${raised};border:0;box-shadow:${edge},${shade}}
+:root:not([data-panel='now']) ${COL}::before,:root:not([data-panel='now']) ${COL}::after{display:none}
+/* under, edge: the main screen is a sheet that lifts and draws back; the panel lies bare on the base under it */
+:root{--q-base:#121215;--q-right:400px;--q-lift:0 18px 50px rgb(0 0 0/.7),0 2px 10px rgb(0 0 0/.5);--q-rim:rgb(255 255 255/.16)}
+:root[data-theme='light']{--q-base:#e2e2e5;--q-lift:0 18px 50px rgb(0 0 0/.22),0 2px 10px rgb(0 0 0/.12);--q-rim:rgb(0 0 0/.12)}
+:root:is([data-panel='under'],[data-panel='edge']) ${COL}{--bg:var(--q-base);background:var(--q-base);border:0}
+:root:is([data-panel='under'],[data-panel='edge'])::before,:root:is([data-panel='under'],[data-panel='edge'])::after{content:'';position:fixed;inset:0;border-radius:0;pointer-events:none;transition:inset .55s cubic-bezier(.2,.8,.2,1),border-radius .55s cubic-bezier(.2,.8,.2,1),box-shadow .3s,opacity .3s}
+:root:is([data-panel='under'],[data-panel='edge'])::before{z-index:11;box-shadow:0 0 0 100vmax var(--q-base)}
+:root:is([data-panel='under'],[data-panel='edge'])::after{z-index:13;opacity:0;box-shadow:var(--q-lift),inset 0 0 0 1px var(--q-rim)}
+${a('panel', 'under')}[data-qopen]::before,${a('panel', 'under')}[data-qopen]::after{inset:8px var(--q-right) 8px 8px;border-radius:24px}
+${a('panel', 'edge')}[data-qopen]::before,${a('panel', 'edge')}[data-qopen]::after{inset:0 var(--q-right) 0 0;border-radius:0 24px 24px 0}
+:root[data-qopen]::after{opacity:1}
+${a('panel', 'touch')} ${COL}[data-side='right']{border-radius:22px 0 0 22px}
+${a('panel', 'touch')} ${COL}[data-side='left']{border-radius:0 22px 22px 0}
+${a('panel', 'touch')} ${INBOX}{border-radius:0 18px 0 0;overflow:hidden}
+${a('panel', 'isle')} ${COL}{top:10px;bottom:10px;border-radius:24px;overflow:hidden}
+${a('panel', 'isle')} ${COL}[data-side='right']{right:10px}
+${a('panel', 'isle')} ${COL}[data-side='left']{left:10px}
+${a('panel', 'isle')} ${INBOX}{border-radius:18px;overflow:hidden;translate:10px -10px}
+
+/* ── 4 dock (a console on the screen's foot) and its drawer ── */
+:root{--q-kr:14px;--q-line:0 0 0 1px var(--line-hover)}
+:root:not([data-dock='now']) ${CON}[data-at='foot']:not([data-full]){border-radius:var(--q-kr) var(--q-kr) 0 0}
+:root:not([data-dock='now']) ${CON}[data-at='foot']:not([data-full]) ${FL}{border-radius:var(--q-kr) var(--q-kr) 0 0;border-bottom:0}
+:root:not([data-dock='now']) ${CON}[data-at='foot']:not([data-full]):has(${FL}:not(:empty)){border-radius:0}
+:root:is([data-dock='line'],[data-dock='pill']) ${CON}[data-at='foot']:not([data-full]){box-shadow:var(--q-line)}
+:root:is([data-dock='line'],[data-dock='pill']) ${CON}[data-at='foot']:not([data-full]) ${FL}{box-shadow:var(--q-line)}
+:root:is([data-dock='line'],[data-dock='pill']) ${CON}[data-at='foot']:not([data-full])::before,:root:is([data-dock='line'],[data-dock='pill']) ${CON}[data-at='foot']:not([data-full]) ${FL}::before{content:none}
+${a('dock', 'line')} ${CON}[data-at='foot']:not([data-full]):is(:hover,:focus-within),${a('dock', 'line')} ${CON}[data-at='foot']:not([data-full]):is(:hover,:focus-within) ${FL}{box-shadow:0 0 0 1px var(--accent-cyan)}
+${a('dock', 'mark')} ${CON}[data-at='foot']:not([data-full])::before,${a('dock', 'mark')} ${CON}[data-at='foot']:not([data-full]) ${FL}::before{background:none;border:var(--line-w) solid var(--mk);border-bottom:0;border-radius:calc(var(--q-kr) + var(--space-1)) calc(var(--q-kr) + var(--space-1)) 0 0;--q-ds:10px;-webkit-mask:linear-gradient(#000 0 0) left top/var(--q-ds) var(--q-ds) no-repeat,linear-gradient(#000 0 0) right top/var(--q-ds) var(--q-ds) no-repeat;mask:linear-gradient(#000 0 0) left top/var(--q-ds) var(--q-ds) no-repeat,linear-gradient(#000 0 0) right top/var(--q-ds) var(--q-ds) no-repeat}
+${a('dock', 'mark')} ${CON}[data-at='foot']:not([data-full]):has(${FL}:not(:empty))::before{content:none}
+${a('dock', 'pill')} ${CON}[data-at='foot']:not([data-full]){bottom:10px;border-radius:999px;padding-inline:8px}
+${a('dock', 'pill')} ${CON}[data-at='foot']:not([data-full]) ${FL}{border-radius:18px 18px 0 0}
+${a('dock', 'pill')} ${CON}[data-at='foot']:not([data-full]):has(${FL}:not(:empty)){border-radius:0 0 18px 18px}
+
+/* ── 5 boxes inside a surface ── */
+${a('box', 'round')} ${SEC}{border-radius:14px}
+${a('box', 'round')} ${FR}:not(${W},${TOAST}){border-radius:14px}
+${a('box', 'fill')} ${SEC}{border:0;border-radius:14px;background:var(--wash-1)}
+${a('box', 'fill')} ${FR}:not(${W},${TOAST}){border-color:transparent;border-radius:14px;background:var(--wash-1)}
+${a('box', 'bare')} ${SEC}{border:0;border-radius:0;padding-inline:0;border-top:var(--line-w) solid var(--line)}
+:root:not([data-box='now']) ${NAV}{border:0;border-radius:999px;outline:none;box-shadow:none}
+:root:not([data-box='now']) ${NAV}[aria-current='page']{background:var(--wash-3)}
+
+/* ── 6 small things: toast, tip ── */
+:root:not([data-small='now']) ${TOAST}{border-color:var(--line-hover)}
+${a('small', 'pill')} ${TOAST}{border-radius:999px;padding-inline:var(--space-4)}
+${a('small', 'pill')} ${TIP}{border-radius:14px;padding-inline:var(--space-3)}
+${a('small', 'round')} ${TOAST}{border-radius:8px}
+${a('small', 'round')} ${TIP}{border-radius:8px}
+
+/* preview only: the toast stays, so its shape can be looked at */
+${TOAST}{opacity:1!important}
+
+/* ── 7 the threads dock, bottom left ── */
+:root:not([data-thread='now']) ${INBOX}{box-shadow:0 0 0 1px var(--line-hover);overflow:clip}
+:root:not([data-thread='now']) ${INBOX}::before,:root:not([data-thread='now']) ${INBOX}::after{display:none}
+${a('thread', 'tab')} ${INBOX}{border-radius:14px 14px 0 0}
+${a('thread', 'isle')} ${INBOX}{border-radius:14px;translate:0 -10px}
+
+/* ── hazard ── */
+${a('hazard', 'glow')} ${HZ}{box-shadow:0 0 0 1px var(--accent-magenta),0 0 70px -8px var(--accent-magenta)}
+
+/* ── marks: they take the corner of what they mark (--corner, which a card's face already sets; nothing set = square = the L).
+   Concentric: the face's radius plus how far out the mark is. min(corner * 9999, …) keeps a square thing's at 0. */
+:root{--q-k:0}
+${dot(face.face)}[data-flat='true']{--corner:0px}
+/* a card on a plane: its marks are drawn beside its face, in the box that holds both */
+*:has(> ${MK}):has(> ${dot(face.face)}):not(:has(> ${dot(plane.frame)})){--corner:var(--w-card-radius)}
+:root:is([data-mark='hug'],[data-mark='tick']) ${MK} i{--q-L:calc(var(--ml) * var(--zs,1));--q-R:calc(var(--corner,0px) + min(var(--corner,0px) * 9999,(var(--mo) + var(--th0)) * var(--zs,1) + var(--pad,0px)));corner-shape:squircle}
+${a('mark', 'hug')} ${MK} i{width:max(var(--q-L),var(--q-R) + var(--q-L) * .3);height:max(var(--q-L),var(--q-R) + var(--q-L) * .3)}
+${a('mark', 'tick')} ${MK} i{width:max(var(--q-L),var(--q-R));height:max(var(--q-L),var(--q-R))}
+:root:is([data-mark='hug'],[data-mark='tick']) ${MK} i[data-c='nw']{border-top-left-radius:var(--q-R)}
+:root:is([data-mark='hug'],[data-mark='tick']) ${MK} i[data-c='ne']{border-top-right-radius:var(--q-R)}
+:root:is([data-mark='hug'],[data-mark='tick']) ${MK} i[data-c='se']{border-bottom-right-radius:var(--q-R)}
+:root:is([data-mark='hug'],[data-mark='tick']) ${MK} i[data-c='sw']{border-bottom-left-radius:var(--q-R)}
+${a('mark', 'tick')} ${MK} i[data-c='nw']{clip-path:inset(0 calc(100% - var(--q-L)) calc(100% - var(--q-L)) 0)}
+${a('mark', 'tick')} ${MK} i[data-c='ne']{clip-path:inset(0 0 calc(100% - var(--q-L)) calc(100% - var(--q-L)))}
+${a('mark', 'tick')} ${MK} i[data-c='se']{clip-path:inset(calc(100% - var(--q-L)) 0 0 calc(100% - var(--q-L)))}
+${a('mark', 'tick')} ${MK} i[data-c='sw']{clip-path:inset(calc(100% - var(--q-L)) calc(100% - var(--q-L)) 0 0)}
+`
+
+export type Pick = { modal: string; drop: string; panel: string; dock: string; box: string; small: string; hazard: string; mark: string; thread: string }
+const START: Pick = { modal: 'line', drop: 'line', panel: 'under', dock: 'line', box: 'round', small: 'pill', hazard: 'ring', mark: 'tick', thread: 'tab' }
+function read(): Pick {
+  const q = new URLSearchParams(location.search).get('round')
+  try {
+    return { ...START, ...JSON.parse(q ?? localStorage.getItem(KEY) ?? '{}') }
+  } catch {
+    return START
+  }
+}
+const apply = (p: Pick) => {
+  for (const k of Object.keys(START) as (keyof Pick)[]) document.documentElement.dataset[k] = p[k]
+}
+const el = document.createElement('style')
+el.textContent = CSS
+document.head.appendChild(el)
+apply(read())
+// The new value itself: read() would go back to the address's first setting, undoing the message that just came.
+addEventListener('storage', (e) => e.key === KEY && e.newValue && apply(JSON.parse(e.newValue)))
+addEventListener('message', (e) => e.data?.round && apply(e.data.round))
+new MutationObserver(() => document.head.lastElementChild !== el && document.head.appendChild(el)).observe(document.head, { childList: true })
+
+// under, edge: how wide the right column is, and whether it's there; the sheet's edge follows.
+let col: HTMLElement | null = null
+const ro = new ResizeObserver(() => col && document.documentElement.style.setProperty('--q-right', col.offsetWidth + 'px'))
+let due = false
+const sync = () => {
+  due = false
+  const c = document.querySelector<HTMLElement>(`${COL}[data-side='right']`)
+  if (c !== col) {
+    ro.disconnect()
+    col = c
+    if (c) {
+      document.documentElement.style.setProperty('--q-right', c.offsetWidth + 'px')
+      ro.observe(c)
+    }
+  }
+  document.documentElement.toggleAttribute('data-qopen', !!c)
+}
+new MutationObserver(() => due || ((due = true), requestAnimationFrame(sync))).observe(document.documentElement, { childList: true, subtree: true })
+sync()
+
+// preview only: the tip's example opens its first word's meaning by itself.
+if (location.hash.includes('c=tip')) {
+  const open = () => document.querySelector<HTMLElement>(dot(tip.word))?.dispatchEvent(new PointerEvent('pointerover', { bubbles: true }))
+  setTimeout(open, 800)
+  setTimeout(open, 2500)
+}
