+import { Component, useEffect, useRef, useState, type ReactNode } from 'react'
+import { example, specOf } from './example'
+import { entryById } from './registry'
+import { Button } from '../ui/primitives/Button'
+import { ButtonGroup } from '../ui/primitives/ButtonGroup'
+import { Window } from '../ui/patterns/Window'
+import { EdgeColumn } from '../ui/patterns/EdgeColumn'
+import { PanelHead } from '../ui/patterns/PanelHead'
+import { PromptPanel } from '../ui/patterns/PromptPanel'
+import type { PromptEntry } from '../ui/foundation/promptModel'
+
+class Safe extends Component<{ children: ReactNode }, { bad: boolean }> {
+  state = { bad: false }
+  static getDerivedStateFromError() {
+    return { bad: true }
+  }
+  render() {
+    return this.state.bad ? <small>—</small> : this.props.children
+  }
+}
+function One({ render }: { render: () => ReactNode }) {
+  return <>{render()}</>
+}
+const show = (id: string, state: string) => {
+  const s = entryById(id)?.states[state]
+  return s ? <Safe><One render={specOf(s).render as () => ReactNode} /></Safe> : <small>yok: {id} / {state}</small>
+}
+
+const none = () => {}
+const ADD: PromptEntry[] = [
+  { key: 'h1', heading: 'pieces' },
+  { key: 'plane', label: 'plane', glyph: '▦', hint: 'cards and links', onSelect: none },
+  { key: 'matrix', label: 'matrix…', glyph: '▤', onSelect: none },
+  { key: 'table', label: 'table…', glyph: '▥', onSelect: none },
+  { key: 'deck', label: 'deck…', glyph: '▧', onSelect: none },
+]
+const TICKS: PromptEntry[] = [
+  { key: 'a', label: 'customers', checked: true, tone: 'var(--type-customer)', onSelect: none },
+  { key: 'b', label: 'problems', checked: true, tone: 'var(--type-problem)', onSelect: none },
+  { key: 'c', label: 'competitors', checked: false, tone: 'var(--type-competitor)', onSelect: none },
+]
+const CTL: [string, string, string][] = [
+  ['now', 'Bugün', 'Her butonun arkasında gri bir hücre.'],
+  ['g-side', 'Seçilen: boş + yan ışık', 'Arka plan yok. Seçilinin yanında mavi ışık, ikon butonlarda ikonun kendisi yanıyor.'],
+]
+const KIT: [string, string, string[]][] = [
+  ['button', 'Button', ['sm tones', 'icons']],
+  ['buttongroup', 'ButtonGroup', []],
+  ['toolbutton', 'ToolButton', ['states']],
+  ['tabs', 'Tabs', []],
+  ['choice', 'Choice', ['picked']],
+  ['checkbox', 'Checkbox', ['on and off', 'checklist']],
+  ['chip', 'Chip', ['tags']],
+  ['field', 'Field', []],
+  ['select', 'Select', ['closed']],
+  ['options', 'Options', ['many of']],
+]
+const CSS = `.rk{position:fixed;inset:0;overflow:auto;background:var(--bg);padding:4px 24px 40px;box-sizing:border-box;color:var(--fg)}
+.rk-scene{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr) 300px;grid-template-rows:auto auto;gap:14px;margin:10px 0 0}
+.rk-t{position:relative;min-width:0;padding:30px 16px 16px;box-shadow:inset 0 0 0 1px var(--line);transition:box-shadow .5s}
+.rk-t[data-flash]{box-shadow:inset 0 0 0 2px var(--accent-cyan);transition:none}
+.rk-t>small{position:absolute;top:8px;left:12px;font:500 12px var(--font-display);color:var(--fg-dim)}
+.rk-t>small b{display:inline-grid;place-items:center;width:17px;height:17px;margin-right:6px;border-radius:50%;background:var(--accent-cyan);color:var(--on-accent);font-weight:600}
+.rk-wide{grid-column:1/3;display:flex;flex-wrap:wrap;gap:14px 26px;align-items:center}
+.rk-panel{grid-column:3;grid-row:1/3;transform:translateZ(0);overflow:hidden;min-height:440px;padding:0}
+.rk-panel>small{z-index:9}
+.rk-panel [role=dialog]{position:absolute;right:0;width:280px;top:34px!important}
+.rk-modal{display:grid;place-items:center;min-height:330px;background:color-mix(in srgb,var(--wash-1) 60%,transparent)}
+.rk-drop{min-height:330px}
+.rk-drop>div{width:250px;margin-top:6px}
+.rk-body{padding:12px 24px;color:var(--fg-dim);font-size:13px}
+.rk-msg{padding:22px 24px 18px}
+.rk-msg h4{margin:0 0 6px;font:500 19px var(--font-display);color:var(--fg-strong)}
+.rk-msg p{margin:0 0 14px;font:13px/1.45 var(--font-display);color:var(--fg-dim)}
+.rk-msg *{max-width:100%;box-sizing:border-box}
+.rk-msg input{width:100%}
+.rk-msg>span{display:flex;justify-content:flex-end;margin-top:14px}
+.rk h2{font:500 12px var(--font-mono);letter-spacing:.05em;text-transform:uppercase;color:var(--accent-magenta);margin:26px 0 8px}
+.rk-c{all:unset;box-sizing:border-box;display:grid;grid-template-columns:230px minmax(0,1fr);gap:24px;width:100%;padding:16px 12px;cursor:pointer;box-shadow:0 1px 0 var(--line)}
+.rk-c:hover{background:var(--wash-1)}
+.rk-c[data-on]{background:var(--wash-1);box-shadow:inset 3px 0 0 var(--accent-cyan),0 1px 0 var(--line)}
+.rk-c>div:first-child>b{display:block;font:500 15px var(--font-display);color:var(--fg-strong)}
+.rk-c>div:first-child>i{display:block;font:normal 13px/1.4 var(--font-display);color:var(--fg-dim);margin-top:3px}
+.rk-s{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;min-width:0}
+.rk-kit{columns:2;column-gap:40px}
+.rk-one{break-inside:avoid;padding:14px 0;border-top:1px solid var(--line);min-width:0}
+.rk-one h3{font:500 12px var(--font-mono);color:var(--fg-dim);margin:0 0 10px}
+.rk-st{display:flex;flex-wrap:wrap;gap:20px 32px;align-items:flex-start}
+.rk-st>div{min-width:0;max-width:100%;position:relative}`
+function Page() {
+  const ref = useRef<HTMLDivElement>(null)
+  const [ctl, setCtl] = useState('g-side')
+  const [srf, setSrf] = useState('touch')
+  const [flash, setFlash] = useState('')
+  useEffect(() => {
+    const t = setInterval(() => parent.postMessage({ rkHeight: ((ref.current?.firstElementChild as HTMLElement | null)?.offsetHeight ?? 0) + 64 }, '*'), 800)
+    let off = 0
+    const on = (e: MessageEvent) => {
+      if (!e.data?.round) return
+      setCtl(e.data.round.ctl)
+      setSrf(e.data.round.srf)
+      if (e.data.changed) {
+        setFlash(e.data.changed)
+        clearTimeout(off)
+        off = window.setTimeout(() => setFlash(''), 450)
+      }
+    }
+    addEventListener('message', on)
+    return () => {
+      clearInterval(t)
+      removeEventListener('message', on)
+    }
+  }, [])
+  return (
+    <div className="rk" ref={ref}><div>
+      <style>{CSS}</style>
+      <div className="rk-scene" data-ctl={ctl} data-srf={srf}>
+        <div className="rk-t rk-wide" data-flash={flash === 'ctl' || undefined}>
+          <small><b>1</b>Butonlar, gruplar, sekmeler</small>
+          <ButtonGroup><Button>filter</Button><Button>linked · 2</Button><Button pressed>setup</Button><Button tone="main">unfocus</Button></ButtonGroup>
+          {show('tabs', 'segments')}
+          <Button>edit</Button>
+          <Button tone="primary">save</Button>
+          {show('toolbutton', 'states')}
+        </div>
+        <div className="rk-t rk-panel" data-flash={flash === 'srf' || undefined}>
+          <small><b>2</b>Sağ panel</small>
+          <EdgeColumn portal={false} escape={false} label="panel" className="">
+            <PanelHead kind="problem" onClose={none} />
+            <div className="rk-msg"><h4>Lunch near the office is expensive</h4><p>6 of 8 interviewed spend over €10.</p></div>
+          </EdgeColumn>
+        </div>
+        <div className="rk-t rk-modal" data-flash={flash === 'srf' || flash === 'ctl' || undefined}>
+          <small><b>2</b>Modal</small>
+          <Window portal={false} modal={false} focus={false} entrance="none" escape={false} label="modal" style={{ width: 340 }}>
+            <div className="rk-msg">
+              <h4>New workspace</h4>
+              {show('field', 'filled')}
+              <span><ButtonGroup><Button>cancel</Button><Button tone="primary">create</Button></ButtonGroup></span>
+            </div>
+          </Window>
+        </div>
+        <div className="rk-t rk-drop" data-flash={flash === 'srf' || undefined}>
+          <small><b>2</b>Dropdown</small>
+          <Button pressed>add ▾</Button>
+          <div><PromptPanel items={ADD} ariaLabel="add" prompt="type to find…" onClose={none} /></div>
+        </div>
+        <div className="rk-t rk-wide" data-flash={flash === 'ctl' || undefined}>
+          <small><b>1</b>Checkbox ve filtre kutuları</small>
+          {show('checkbox', 'on and off')}
+          {show('checkbox', 'checklist')}
+          <div style={{ width: 240 }}><PromptPanel items={TICKS} ariaLabel="filter" prompt="filter…" onClose={none} /></div>
+        </div>
+      </div>
+      <h2>Bugün ve seçilen</h2>
+      {CTL.map(([k, n, d]) => (
+        <div className="rk-c" key={k} data-ctl={k} data-on={ctl === k || undefined} role="button" tabIndex={0} onClick={() => parent.postMessage({ pick: k }, '*')}>
+          <div><b>{n}</b><i>{d}</i></div>
+          <div className="rk-s">
+            {show('buttongroup', 'a dock')}
+            {show('buttongroup', 'a console in edit mode')}
+            {show('toolbutton', 'states')}
+            {show('tabs', 'segments')}
+            {show('choice', 'picked')}
+            {show('checkbox', 'on and off')}
+          </div>
+        </div>
+      ))}
+      <h2>Onaylanan: bütün küçük parçalar</h2>
+      <div className="rk-kit" data-ctl={ctl}>
+        {KIT.map(([id, name, want]) => {
+          const e = entryById(id)
+          if (!e) return <small key={id}>yok: {id}</small>
+          const names = want.length ? want : Object.keys(e.states).slice(0, 3)
+          return (
+            <section className="rk-one" key={id}>
+              <h3>{name}</h3>
+              <div className="rk-st">{names.map((n) => <div key={n}>{show(id, n)}</div>)}</div>
+            </section>
+          )
+        })}
+      </div>
+    </div></div>
+  )
+}
+export default example({ name: 'RoundKit', place: 'actions/buttons', file: 'src/ui/primitives/Button.tsx', note: 'throwaway', states: { all: () => <Page /> } })
