+${S} ${CON}[data-at='foot']{bottom:10px;border-radius:999px;padding-inline:8px;background:var(--bg-raised);box-shadow:${edge},${shade}}
+${S} ${CON}[data-at='foot']::before{content:none}
+${S} ${FR}{border-radius:16px}
+${S} ${dot(settings.dialog)}{border-radius:28px}
+`
+const cut = (S: string) => `${sheet(S)}
+${S} :is(${W},${HZ}){border-radius:18px;corner-shape:bevel}
+${S} ${FL}{border-radius:12px 12px 0 0;corner-shape:bevel}
+${S} ${SEC}{border-radius:10px;corner-shape:bevel}
+${S} ${H},${S} ${POP}{border-radius:12px;corner-shape:bevel}
+${S} ${R}{border-radius:6px;corner-shape:bevel}
+${S} ${TOAST}{border-radius:10px;corner-shape:bevel}
+${S} ${TIP}{border-radius:8px;corner-shape:bevel}
+${S} ${COL}{--bg:var(--bg-raised);background:var(--bg-raised);border:0;box-shadow:${edge},${shade}}
+${S} ${COL}[data-side='right']{border-radius:24px 0 0 24px;corner-shape:bevel}
+${S} ${COL}[data-side='left']{border-radius:0 24px 24px 0;corner-shape:bevel}
+${S} ${CON}[data-at='foot']{border-radius:12px 12px 0 0;corner-shape:bevel;background:var(--bg-raised);box-shadow:${edge}}
+${S} ${CON}[data-at='foot']::before{content:none}
+${S} ${FR}{border-radius:10px;corner-shape:bevel}
+`
+// What each family shares: the page's big button, a person's square, the badges, Settings' list; the prompt's own line last.
+const family = (S: string, r: string, person: string, shape: string) => `
+${S} ${md}{border-radius:${r};${shape};overflow:hidden}
+${S} :is(${av}){border-radius:${person};${shape}}
+${S} ${bdg}{border-radius:999px}
+${S} ${nav}{border-radius:${r === '999px' ? '999px' : '8px'};${shape};box-shadow:none;outline:none;border:0}
+${S} ${nav}[aria-current='page']{background:var(--wash-3);box-shadow:none}
+${S} ${pf} ${f},${S} ${pin},${S} ${pin}:hover,${S} ${pin}:focus{padding:0;margin:0;width:100%;border:0;border-radius:0;background:none;box-shadow:none}
+`
+const c = (x: string) => `[data-ctl='${x}']`
+const s = (x: string) => `[data-srf='${x}']`
+const round = 'corner-shape:round'
+const sq = 'corner-shape:squircle'
+const MIX: [string, boolean, boolean][] = [['g-side', false, false], ['g-under', false, true], ['t-side', true, false], ['t-under', true, true]]
+const CSS = MIX.map(([k, t, u]) => mix(c(k), t, u) + family(c(k), '999px', '50%', round) + sw(c(k)) + ticks(c(k)) + swTicks(c(k))).join('') + leaf(s('leaf')) + touch(s('touch')) + isle(s('isle'))
+
+type Pick = { ctl: string; srf: string; chk: string }
+const START: Pick = { ctl: 'g-side', srf: 'touch', chk: 'lamp' }
+function read(): Pick {
+  const q = new URLSearchParams(location.search).get('round')
+  try {
+    return { ...START, ...JSON.parse(q ?? localStorage.getItem(KEY) ?? '{}') }
+  } catch {
+    return START
+  }
+}
+// The kit's frame shows every control side by side, each in its own box, so its root stays out of it.
+const sideBySide = location.hash.includes('c=roundkit')
+const apply = (p: Pick) => {
+  document.documentElement.dataset.chk = p.chk
+  if (sideBySide) return
+  document.documentElement.dataset.ctl = p.ctl
+  document.documentElement.dataset.srf = p.srf
+}
+const el = document.createElement('style')
+el.textContent = CSS
+document.head.appendChild(el)
+apply(read())
+// The new value itself: read() would go back to the address's first setting, undoing the message that just came.
+addEventListener('storage', (e) => e.key === KEY && e.newValue && apply(JSON.parse(e.newValue)))
+addEventListener('message', (e) => e.data?.round && apply(e.data.round))
+new MutationObserver(() => document.head.lastElementChild !== el && document.head.appendChild(el)).observe(document.head, { childList: true })
