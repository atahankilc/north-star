+// Throwaway preview: other ways to draw the controls and the surfaces, laid over the real CSS. Cards and pieces are
+// left alone. Never lands in the repo.
+import button from './ui/primitives/Button.module.css'
+import group from './ui/primitives/ButtonGroup.module.css'
+import tool from './ui/primitives/ToolButton.module.css'
+import field from './ui/primitives/Field.module.css'
+import promptField from './ui/primitives/PromptField.module.css'
+import chip from './ui/primitives/Chip.module.css'
+import check from './ui/primitives/Checkbox.module.css'
+import tabs from './ui/primitives/Tabs.module.css'
+import row from './ui/primitives/PromptRow.module.css'
+import win from './ui/patterns/Window.module.css'
+import menu from './ui/patterns/Menu.module.css'
+import popover from './ui/patterns/Popover.module.css'
+import toast from './ui/patterns/Toast.module.css'
+import tip from './ui/patterns/Tip.module.css'
+import panel from './ui/patterns/PromptPanel.module.css'
+import column from './ui/patterns/EdgeColumn.module.css'
+import consoleCss from './ui/patterns/Console.module.css'
+import frame from './ui/foundation/Frame.module.css'
+import options from './ui/patterns/Options.module.css'
+import avatar from './ui/primitives/Avatar.module.css'
+import badge from './ui/primitives/CountBadge.module.css'
+import settings from './ui/patterns/Settings.module.css'
+import hazard from './ui/patterns/HazardConfirm.module.css'
+import promptFrame from './ui/foundation/PromptFrame.module.css'
+
+export const KEY = 'round-demo'
+const dot = (x?: string) => '.' + (x ?? 'nope').split(' ')[0]
+const sm = dot(button.sm)
+const tl = dot(tool.tool)
+const grp = dot(group.group)
+const trow = dot(tabs.row)
+const tab = dot(tabs.option)
+const chk = dot(check.check)
+const f = dot(field.field)
+const pf = dot(promptField.prompt)
+const pin = dot(promptField.input)
+const ch = dot(chip.chip)
+const opt = dot(options.option)
+const md = dot(button.md)
+const av = `${dot(avatar.avatar)},${dot(settings.avatar)}`
+const bdg = `${dot(badge.badge)}`
+const nav = dot(settings.navItem)
+const ON = `:is([aria-pressed='true'],[aria-checked='true'],[aria-selected='true'],[data-active='true'])`
+const OFF = `:is([aria-pressed='false'],[aria-checked='false'],[aria-selected='false'])`
+const act = `${sm}:not([data-link])`
+const hov = `:is(:hover,:focus-visible):not(:disabled)`
+const tones = (S: string, pad: string) => `
+${S} ${act}{box-shadow:none;transition:background var(--dur-fast) var(--ease-out),color var(--dur-fast) var(--ease-out),box-shadow var(--dur-fast) var(--ease-out),translate var(--dur-fast) var(--ease-out)}
+${S} ${act}:not([data-icon]){padding-inline:${pad}}
+${S} ${tl}[data-on='true']{box-shadow:none}
+`
+// A: nothing behind a button until the pointer's on it. Only the one go is filled. Pills.
+const ghost = (S: string) => `${tones(S, 'calc(var(--button-pad,var(--space-2))*1.3)')}
+${S} ${act}{background:none;color:var(--fg-dim);border-radius:999px}
+${S} ${act}[data-tone='main']{color:var(--fg-strong)}
+${S} ${act}[data-tone='danger']{color:var(--accent-magenta)}
+${S} ${act}${hov}{background:var(--wash-3);color:var(--fg-strong)}
+${S} ${act}[data-tone='primary']{background:var(--accent-cyan);color:var(--on-accent)}
+${S} ${act}[data-tone='hazard']{background:var(--accent-magenta);color:var(--on-accent)}
+${S} ${act}${ON}{background:var(--wash-cyan);color:var(--accent-cyan)}
+${S} ${grp},${S} ${trow}{gap:2px}
+${S} ${tl}{background:none;border-radius:999px}
+${S} ${tl}${hov}{background:var(--wash-3)}
+${S} ${tl}[data-on='true']{background:var(--wash-cyan)}
+${S} ${chk}[aria-checked='false']:not([data-icon])::before{content:'';flex:none;width:10px;height:10px;margin-right:6px;border-radius:3px;box-shadow:inset 0 0 0 1px var(--fg-faint)}
+${S} ${f}{border:0;border-radius:10px;padding:7px 10px;margin-inline:-10px;width:calc(100% + 20px);background:none}
+${S} ${f}:hover{background:var(--wash-1)}
