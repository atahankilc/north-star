+<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Kontroller ve yüzeyler</title>
+<style>
+:root{color-scheme:dark}*{box-sizing:border-box}
+body{margin:0;background:#000;color:#e8e8e8;font:14px/1.45 -apple-system,Inter,sans-serif}
+body[data-t=light]{background:#f3f3f3;color:#111}
+aside{position:fixed;inset:0 auto 0 0;width:320px;overflow:auto;padding:18px 18px 24px;background:#0c0c0d;box-shadow:1px 0 0 #8884}
+body[data-t=light] aside{background:#fff}
+main{margin-left:320px;min-width:0}
+fieldset{all:unset;display:block;margin-bottom:20px}
+.h{display:flex;align-items:center;gap:8px;font-weight:600;font-size:14px}
+.h b{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#2fd9e0;color:#000;font-size:12px;flex:none}
+.what{margin:2px 0 8px 28px;font-size:12.5px;opacity:.65}
+button{all:unset;box-sizing:border-box;display:block;width:100%;padding:7px 10px 7px 28px;margin-top:2px;border-radius:12px;cursor:pointer;font-size:13.5px;position:relative}
+button::before{content:'';position:absolute;left:10px;top:12px;width:9px;height:9px;border-radius:50%;box-shadow:inset 0 0 0 1px #8889}
+button i{display:block;font-style:normal;font-size:12px;opacity:.65}
+button:hover{background:#8882}
+button[data-on=true]{background:#2fd9e022}
+button[data-on=true]::before{background:#2fd9e0;box-shadow:0 0 6px #2fd9e0}
+button:focus-visible{outline:2px solid #2fd9e0;outline-offset:-2px}
+a{color:inherit;opacity:.75;font-size:13px}
+h2{font:500 12px ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.05em;margin:34px 24px 12px;color:#ff3d9a}
+.grid{display:grid;gap:16px;padding:0 24px 8px;grid-template-columns:repeat(auto-fit,minmax(480px,1fr))}
+figure{margin:0}figure.w{grid-column:1/-1}figcaption{opacity:.7;margin-bottom:6px;font-size:13px}
+iframe{display:block;width:100%;border:0;background:#0000}
+#kit{height:1500px}
+</style></head><body>
+<aside id="side"></aside>
+<main><iframe id="kit" title="kit"></iframe><div id="rest"></div></main>
+<script type="module">
+const KEY='round-demo'
+const st={ctl:'g-side',srf:'touch',chk:'lamp',theme:'dark',...JSON.parse(sessionStorage.ui6||'{}')}
+const GROUPS=[
+['ctl','1','Butonlar ve seçim','Değişen: butonlar, gruplar, sekmeler, tik kutuları',[
+ ['now','Bugün','Her butonun arkasında gri hücre'],
+ ['g-side','Seçilen','Boş + yan ışık, ikon kendisi yanıyor']]],
+['srf','2','Modal, dropdown, panel (henüz karar yok)','Değişen: bu yüzeylerin köşeleri ve gölgesi',[
+ ['now','Bugün','Köşeli, ince çizgi, L işaretleri'],
+ ['leaf','Yaprak','Gölgeli, büyük squircle, panel köşeli'],
+ ['touch','Değen köşe','Bir şeye değen köşe keskin, boştaki yuvarlak'],
+ ['isle','Ada','Paneller kenardan ayrılıp yüzüyor, hepsi yuvarlak']]],
+['theme','','Tema','',[['dark','Koyu',''],['light','Açık','']]],
+]
+const cur=()=>({ctl:st.ctl,srf:st.srf,chk:st.chk})
+const send=changed=>{localStorage.setItem(KEY,JSON.stringify(cur()));sessionStorage.ui6=JSON.stringify(st);document.querySelectorAll('iframe').forEach(f=>f.contentWindow?.postMessage({round:cur(),changed},'*'))}
+const side=document.getElementById('side')
+for(const[key,n,title,what,opts]of GROUPS){const fs=document.createElement('fieldset');fs.dataset.k=key;fs.innerHTML=`<div class="h">${n?`<b>${n}</b>`:''}${title}</div>${what?`<div class="what">${what}</div>`:''}`
+for(const[v,t,d]of opts){const b=document.createElement('button');b.dataset.v=v;b.innerHTML=t+(d?`<i>${d}</i>`:'');b.onclick=()=>pick(key,v);fs.append(b)}side.append(fs)}
+side.insertAdjacentHTML('beforeend','<a href="/" target="_blank">gerçek uygulama ↗</a>')
+const paint=()=>side.querySelectorAll('fieldset').forEach(fs=>fs.querySelectorAll('button').forEach(b=>b.dataset.on=b.dataset.v===st[fs.dataset.k]))
+function pick(key,v){st[key]=v;paint();if(key==='theme'){document.body.dataset.t=v;send();load()}else send(key)}
+document.body.dataset.t=st.theme;paint()
+const SEC=[
+['Modal',[['settings|open-display','Settings',720,1],['wizardshell','WizardShell',500],['hazardconfirm','Silme onayı',360]]],
+['Dropdown ve menü',[['menu|open','Menu',360],['select|open','Select',360],['right-click-menu|card','Sağ tık',420],['finder|typed','Finder',480]]],
+['Panel ve dock',[['sidepanel|default','Sağ panel',620],['focused-plane|filter-open','Alt dock, çekmecesi açık',620]]],
+['Uygulamanın içinde (kartlar ve parçalar değişmedi)',[['focused-plane|in-focus','Plane odakta',620,1]]],
+]
+const addr=c=>`/gallery.html?round=${encodeURIComponent(JSON.stringify(cur()))}#c=${c.split('|')[0]}${c.includes('|')?'&s='+c.split('|')[1]:''}&theme=${st.theme}&motion=reduced&alone`
+function load(){const kit=document.getElementById('kit');kit.dataset.c='roundkit';const q=[kit];const r=document.getElementById('rest');r.innerHTML=''
+for(const[t,items]of SEC){const h=document.createElement('h2');h.textContent=t;const g=document.createElement('div');g.className='grid';for(const[c,n,hh,w]of items){const f=document.createElement('figure');if(w)f.className='w';f.innerHTML=`<figcaption>${n}</figcaption><iframe title="${n}" style="height:${hh}px"></iframe>`;const i=f.querySelector('iframe');i.dataset.c=c;q.push(i);g.append(f)}r.append(h,g)}
+const tell=i=>i.contentWindow?.postMessage({round:cur()},'*')
+const next=()=>{const i=q.shift();if(!i)return;i.onload=()=>{tell(i);setTimeout(()=>tell(i),1500);setTimeout(()=>tell(i),4000);setTimeout(next,300)};i.src=addr(i.dataset.c)};next();setTimeout(next,1500)}
+addEventListener('message',e=>{if(e.data?.rkHeight)document.getElementById('kit').style.height=e.data.rkHeight+'px';if(e.data?.pick)pick('ctl',e.data.pick)})
+send();load()
+</script></body></html>
