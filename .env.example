# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These values are public by design; security is enforced by firestore.rules and database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
# Optional: the Storage bucket for attachments (D-083). Defaults to <project id>.firebasestorage.app.
VITE_FIREBASE_STORAGE_BUCKET=
