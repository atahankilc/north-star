rules_version = '2';

// Files in Storage (needs Blaze). Nothing is stored yet: documents' files (images, PDFs, D-232) come with Storage, at
// workspaces/{wid}/documents/{id}/…, and get their rules then. Until then nobody reads or writes anything.
// Deploy: npm run deploy:rules
service firebase.storage {
  match /b/{bucket}/o {
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
