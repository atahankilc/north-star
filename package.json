{
  "name": "north-star",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.demo.config.ts && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-north-star",
    "test:rules": "firebase emulators:exec --project demo-north-star --only auth,firestore,database,storage \"node tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database --project north-star-db",
    "deploy:storage": "firebase deploy --only storage --project north-star-db",
    "build:functions": "npm --prefix functions run build",
    "deploy:functions": "firebase deploy --only functions --project north-star-db",
    "check:memory": "node scripts/check-memory.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:gallery": "node scripts/check-gallery.mjs",
    "check:gallery:live": "node scripts/check-gallery-live.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:kit": "node scripts/check-kit.mjs",
    "test": "vitest run",
    "eval": "node evals/cli.mjs",
    "eval:quick": "node evals/cli.mjs --set regression",
    "lint": "eslint --max-warnings=-1 ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-collaboration": "^3.32.3",
    "@tiptap/extension-collaboration-caret": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/extensions": "^3.32.3",
    "@tiptap/markdown": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/y-tiptap": "^3.1.0",
    "fflate": "^0.8.2",
    "firebase": "^13.0.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
