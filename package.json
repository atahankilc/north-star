{
  "name": "north-star",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-north-star",
    "test:rules": "firebase emulators:exec --project demo-north-star --only auth,firestore,database,storage \"node tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database,storage --project north-star-db",
    "build:functions": "npm --prefix functions run build",
    "deploy:functions": "firebase deploy --only functions --project north-star-db",
    "check:memory": "node scripts/check-memory.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.2",
    "firebase": "^13.0.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.0",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
